# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Environment
.env
.env.local
.env.*.local

# Data outputs
# Keep raw/interim/processed datasets and generated analytical outputs ignored by default.
data/raw/*
data/interim/*
data/processed/*
data/public/*
outputs/figures/*
outputs/tables/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/public/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Web report public assets
# The interactive report is static on Vercel, so the exported JSON files used by Astro/Svelte are intentionally versioned here.
!web/public/
!web/public/data/
!web/public/data/*.json
!web/public/data/.gitkeep

# Reports
reports/*.html
reports/*.pdf
reports/*_files/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / web layer
node_modules/
dist/
.astro/
.vercel/
