<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Global Health Signals | WHO + TabPFN</title>
    <meta name="description" content="Editorial analytical report using WHO Global Health Observatory data and TabPFN to model life expectancy, data gaps and health-system signals." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root{--bg:#050505;--ink:#f7f3e8;--soft:#d8d0c3;--muted:#a39c91;--dim:#6e675f;--line:rgba(247,243,232,.14);--panel:rgba(255,255,255,.045);--panel2:rgba(255,255,255,.075);--green:#d7ff6f;--blue:#9fc8ff;--red:#ff7777;--violet:#c8b6ff}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 82% 8%,rgba(215,255,111,.13),transparent 23%),radial-gradient(circle at 8% 30%,rgba(159,200,255,.10),transparent 28%),radial-gradient(circle at 74% 72%,rgba(200,182,255,.07),transparent 22%),var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;background:linear-gradient(rgba(247,243,232,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(247,243,232,.024) 1px,transparent 1px);background-size:78px 78px;pointer-events:none;z-index:-1}a{color:inherit;text-decoration:none}.shell{max-width:1480px;margin:0 auto;padding:28px}.nav{min-height:62px;display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid var(--line);position:sticky;top:0;background:linear-gradient(to bottom,rgba(5,5,5,.98),rgba(5,5,5,.76));backdrop-filter:blur(18px);z-index:20}.brand,.navlinks,.eyebrow,.tag,.metric-label,.chapter-label,.micro,.chart-note{font-family:'IBM Plex Mono',monospace}.brand{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--green);white-space:nowrap}.navlinks{display:flex;gap:18px;font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700}.hero{min-height:calc(100vh - 90px);display:grid;align-items:end;padding:88px 0 58px}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:800}.hero h1{font-size:clamp(64px,9.4vw,148px);line-height:.79;letter-spacing:-.095em;margin:22px 0 28px;max-width:1220px}.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1px rgba(247,243,232,.72)}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;border-top:1px solid var(--line);padding-top:24px}.lead{font-size:24px;line-height:1.25;letter-spacing:-.045em;color:#e0d8cb;margin:0}.hero-note{border:1px solid var(--line);border-radius:28px;padding:22px;background:linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.02))}.hero-note p{margin:0;color:var(--muted);line-height:1.45;font-size:15.5px}.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tag{border:1px solid var(--line);border-radius:999px;padding:8px 10px;font-size:11px;text-transform:uppercase;color:var(--muted);background:rgba(255,255,255,.03)}.section{padding:96px 0;border-top:1px solid var(--line)}.section-head{display:grid;grid-template-columns:.42fr 1.58fr;gap:34px;margin-bottom:30px}.section h2{font-size:clamp(42px,5.7vw,88px);line-height:.91;letter-spacing:-.08em;margin:0}.section-copy{font-size:19px;line-height:1.45;color:var(--muted);margin:18px 0 0;max-width:820px}.chapter-label{display:inline-flex;gap:8px;align-items:center;padding:8px 11px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.12em;background:rgba(255,255,255,.025)}.story-card{border:1px solid var(--line);border-radius:34px;background:linear-gradient(135deg,rgba(255,255,255,.065),rgba(255,255,255,.02));overflow:hidden}.story-grid{display:grid;grid-template-columns:1fr 1fr}.story-text{padding:28px;border-right:1px solid var(--line)}.story-text h3{font-size:32px;line-height:1;letter-spacing:-.06em;margin:0 0 16px}.story-text p{margin:0 0 14px;color:var(--soft);line-height:1.48;font-size:16px}.story-text p:last-child{margin-bottom:0}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric{border:1px solid var(--line);border-radius:24px;padding:22px;background:var(--panel)}.metric strong{display:block;font-size:clamp(34px,4vw,62px);letter-spacing:-.075em;line-height:.9}.metric-label{display:block;margin-top:12px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.chart-card{border:1px solid var(--line);border-radius:26px;padding:22px;background:rgba(0,0,0,.20);min-height:360px}.chart-card h3{font-size:25px;line-height:1.05;letter-spacing:-.055em;margin:0 0 8px}.chart-card .explain{color:var(--muted);font-size:14px;line-height:1.38;margin:0 0 18px}.bar{display:grid;grid-template-columns:168px 1fr 74px;gap:10px;align-items:center;margin:11px 0}.bar span{font-size:12px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-track{height:12px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden}.bar-fill{height:100%;background:linear-gradient(90deg,var(--green),rgba(215,255,111,.48));border-radius:999px}.bar-value{text-align:right;color:var(--ink)!important}.comparison{display:grid;gap:14px}.model-row{display:grid;grid-template-columns:210px 1fr 110px;gap:14px;align-items:center;border:1px solid var(--line);border-radius:22px;padding:18px;background:rgba(255,255,255,.03)}.model-row:first-child{background:linear-gradient(135deg,rgba(215,255,111,.14),rgba(255,255,255,.03));border-color:rgba(215,255,111,.38)}.model-row strong{font-size:20px;letter-spacing:-.035em}.model-row small{font-family:'IBM Plex Mono';color:var(--muted);font-size:11px}.model-score{text-align:right}.model-score strong{display:block;color:var(--green)}.model-score small{display:block}.residual-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.finding{border:1px solid var(--line);border-radius:24px;padding:22px;background:rgba(0,0,0,.20)}.finding strong{display:block;font-size:36px;letter-spacing:-.07em;color:var(--green);line-height:.95}.finding p{margin:12px 0 0;color:var(--muted);line-height:1.4}.finding b{color:var(--ink)}.line-chart{width:100%;height:300px}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:620px}.table th,.table td{border-bottom:1px solid var(--line);padding:13px 10px;text-align:left;font-size:13px}.table th{font-family:'IBM Plex Mono';font-size:10px;text-transform:uppercase;color:var(--muted);letter-spacing:.1em}.brief-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.brief{border:1px solid var(--line);border-radius:24px;padding:22px;background:rgba(255,255,255,.035)}.brief h3{font-size:24px;line-height:1.05;letter-spacing:-.05em;margin:0 0 12px}.brief p{color:var(--muted);line-height:1.43;margin:0}.notice{border:1px solid var(--red);border-radius:20px;padding:18px;color:#ffd6d6;background:rgba(255,119,119,.08);margin:24px 0}.footer{padding:70px 0 30px;color:var(--muted);border-top:1px solid var(--line)}.reveal{opacity:1;transform:none;transition:opacity .7s ease,transform .7s ease}.js .reveal{opacity:0;transform:translateY(22px)}.js .reveal.in{opacity:1;transform:none}@media(max-width:1000px){.shell{padding:18px}.nav{height:auto;padding:14px 0;align-items:flex-start;gap:12px;flex-direction:column}.navlinks{overflow-x:auto;gap:10px;width:100%;padding-bottom:4px}.hero{min-height:auto;padding:58px 0}.hero h1{font-size:clamp(52px,15vw,84px)}.hero-grid,.section-head,.story-grid,.metrics,.chart-grid,.residual-grid,.brief-grid{grid-template-columns:1fr}.story-text{border-right:0;border-bottom:1px solid var(--line)}.lead{font-size:19px}.section{padding:70px 0}.section h2{font-size:44px}.model-row{grid-template-columns:1fr}.model-score{text-align:left}.bar{grid-template-columns:104px 1fr 56px}.chart-card{min-height:auto}}
    </style>
  </head>
  <body>
    <script>document.documentElement.classList.add('js');</script>
    <div class="shell">
      <nav class="nav"><a class="brand" href="#top">Global Health Signals</a><div class="navlinks"><a href="#question">Question</a><a href="#data">Data</a><a href="#model">Model</a><a href="#residuals">Residuals</a><a href="#brief">Brief</a></div></nav>
      <main id="top">
        <section class="hero"><div><p class="eyebrow reveal">WHO GHO Data / TabPFN / Health Intelligence</p><h1 class="reveal">Predicting life expectancy from <em>health-system signals.</em></h1><div class="hero-grid reveal"><p class="lead" id="heroLead">Can public health indicators from WHO explain and predict differences in life expectancy across countries?</p><div class="hero-note"><p>This is not a traditional dashboard. It is an analytical story: first we check what the WHO data can and cannot tell us, then we test whether a tabular foundation model can learn the signal, and finally we inspect the countries where reality diverges from the model.</p><div class="tags"><span class="tag">WHO GHO API</span><span class="tag">Life expectancy</span><span class="tag">TabPFN</span><span class="tag">Prior Labs</span><span class="tag">Country-year data</span></div></div></div><div id="loadNotice"></div></div></section>

        <section class="section" id="question"><div class="section-head reveal"><span class="chapter-label">00 / Analytical framing</span><div><h2>The project asks a simple question with messy data.</h2><p class="section-copy">If a country reports mortality, immunization, health expenditure and data-quality signals, can we estimate its life expectancy? The answer matters because the model residuals become a second layer of intelligence: they show where countries perform better or worse than expected.</p></div></div><div class="story-card reveal"><div class="story-grid"><div class="story-text"><h3>Why life expectancy?</h3><p>Life expectancy is a compact outcome. It reflects many interacting systems: child survival, maternal care, infectious disease control, chronic risk, sanitation, public spending and institutional capacity.</p><p>The model does not diagnose countries. It tests whether public health indicators contain enough structure to estimate this outcome across time and geography.</p></div><div class="story-text"><h3>Why TabPFN?</h3><p>WHO data is tabular, heterogeneous and incomplete. TabPFN is useful here because the project has a classic tabular prediction task: rows are country-years, columns are public health signals, and the target is numerical.</p><p>The baseline models remain in the report to keep the result honest. TabPFN only matters if it improves over simpler approaches.</p></div></div></div></section>

        <section class="section" id="data"><div class="section-head reveal"><span class="chapter-label">01 / Data foundation</span><div><h2>A global dataset with uneven signals.</h2><p class="section-copy">The WHO data is broad, but not uniformly complete. Instead of hiding that, the report treats missingness as part of the story. Countries and years with fewer available indicators carry less analytical certainty.</p></div></div><div class="metrics reveal" id="datasetMetrics"></div><div class="chart-grid reveal"><div class="chart-card"><h3>Which variables are usable?</h3><p class="explain">These are the indicators with the strongest coverage in the analytical table. High coverage means the variable is more reliable for cross-country modeling.</p><div id="coverageBars"></div></div><div class="chart-card"><h3>Where are the data gaps?</h3><p class="explain">Average completeness varies by WHO region. This matters because a prediction model can only learn from what is consistently measured.</p><div id="regionCompleteness"></div></div></div></section>

        <section class="section" id="model"><div class="section-head reveal"><span class="chapter-label">02 / Prediction layer</span><div><h2>TabPFN cuts the error below one year.</h2><p class="section-copy">The test set uses 2015 onward, so the model is evaluated on recent country-year records. The key result: TabPFN predicts life expectancy with substantially lower error than Ridge and Random Forest.</p></div></div><div class="story-card reveal"><div class="story-grid"><div class="story-text"><h3>How to read the metric</h3><p>MAE means mean absolute error. A MAE of 0.94 means the model was off by less than one year of life expectancy on average across the test records.</p><p>R² measures how much of the variation is captured by the model. Values closer to 1 indicate stronger predictive fit.</p></div><div class="story-text"><div class="comparison" id="modelComparison"></div></div></div></div></section>

        <section class="section" id="residuals"><div class="section-head reveal"><span class="chapter-label">03 / Residual intelligence</span><div><h2>The most interesting cases are the model errors.</h2><p class="section-copy">A residual is actual minus predicted. Positive residuals mean life expectancy was higher than expected. Negative residuals mean it was lower than expected. These outliers become candidates for qualitative investigation.</p></div></div><div class="residual-grid reveal" id="findingCards"></div><div class="chart-grid reveal"><div class="chart-card"><h3>Regional model difficulty</h3><p class="explain">Regions with higher error may have more heterogeneous country profiles, sharper shocks or less complete data patterns.</p><div id="regionResiduals"></div></div><div class="chart-card"><h3>Error over time</h3><p class="explain">The peak in 2021 is analytically important because it may reflect pandemic-era disruption and sudden shifts in mortality patterns.</p><svg class="line-chart" id="yearResiduals" viewBox="0 0 600 300"></svg></div></div></section>

        <section class="section" id="brief"><div class="section-head reveal"><span class="chapter-label">04 / Intelligence brief</span><div><h2>What the first version already says.</h2><p class="section-copy">This first report establishes the analytical backbone. It shows that public WHO indicators can predict life expectancy well, but the data gaps and residual outliers are just as important as the headline score.</p></div></div><div class="brief-grid reveal"><article class="brief"><h3>Signal</h3><p>Mortality and coverage indicators contain enough structure to estimate life expectancy across recent country-year records.</p></article><article class="brief"><h3>Uncertainty</h3><p>Coverage is not evenly distributed. The final report should keep data completeness visible instead of treating it as a technical footnote.</p></article><article class="brief"><h3>Next question</h3><p>Outlier countries deserve a second layer: what changed locally that the model did not fully capture?</p></article></div><div class="story-card reveal" style="margin-top:14px"><div class="story-text"><h3>Countries with the highest average prediction error</h3><p>These are not automatically “bad” results. They are the records where the model needs more context. In the final version, they can become case cards with country-level drill-down.</p></div><div class="panel-inner table-wrap"><table class="table" id="countryTable"><thead><tr><th>Country</th><th>Region</th><th>Mean error</th><th>Mean residual</th></tr></thead><tbody></tbody></table></div></div></section>
      </main>
      <footer class="footer">Built from WHO Global Health Observatory data. Modeling layer: Prior Labs / TabPFN. Repository: who-global-health-signals.</footer>
    </div>
    <script type="module">
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => Number(n).toLocaleString('en-US', { maximumFractionDigits: 2 });
      const labelName = (s) => String(s ?? '').replaceAll('_', ' ').replace(/\b\w/g, c => c.toUpperCase());
      const load = async (name) => { const response = await fetch(`/data/${name}.json`, { cache: 'no-store' }); if (!response.ok) throw new Error(`Could not load /data/${name}.json (${response.status})`); return response.json(); };
      function bars(el, data, label, value, max = null) { const values = data.map((d) => Number(d[value]) || 0); const m = max ?? Math.max(...values, 0.01); el.innerHTML = data.map((d) => `<div class="bar"><span title="${labelName(d[label])}">${labelName(d[label])}</span><div class="bar-track"><div class="bar-fill" style="width:${Math.max(2, ((Number(d[value]) || 0) / m) * 100)}%"></div></div><span class="bar-value">${fmt(Number(d[value]) || 0)}</span></div>`).join(''); }
      function drawYearLine(svg, data) { const w = 600, h = 300, margin = { top: 24, right: 24, bottom: 36, left: 46 }; const years = data.map((d) => Number(d.year)); const vals = data.map((d) => Number(d.mean_abs_error)); const minX = Math.min(...years), maxX = Math.max(...years), maxY = Math.max(...vals) * 1.15; const sx = (x) => margin.left + ((x - minX) / Math.max(1, maxX - minX)) * (w - margin.left - margin.right); const sy = (y) => h - margin.bottom - (y / Math.max(0.01, maxY)) * (h - margin.top - margin.bottom); const points = data.map((d) => `${sx(Number(d.year))},${sy(Number(d.mean_abs_error))}`).join(' '); const xTicks = [...new Set(years)].filter((_, i) => i % 2 === 0); const yTicks = [0, maxY / 2, maxY]; svg.innerHTML = `<line x1="${margin.left}" y1="${h-margin.bottom}" x2="${w-margin.right}" y2="${h-margin.bottom}" stroke="rgba(247,243,232,.16)"/><line x1="${margin.left}" y1="${margin.top}" x2="${margin.left}" y2="${h-margin.bottom}" stroke="rgba(247,243,232,.16)"/>${xTicks.map(t=>`<text x="${sx(t)}" y="${h-12}" fill="#a9a39a" font-size="10" text-anchor="middle">${t}</text>`).join('')}${yTicks.map(t=>`<text x="${margin.left-8}" y="${sy(t)+4}" fill="#a9a39a" font-size="10" text-anchor="end">${fmt(t)}</text>`).join('')}<polyline points="${points}" fill="none" stroke="#d7ff6f" stroke-width="2"/>${data.map(d=>`<circle cx="${sx(Number(d.year))}" cy="${sy(Number(d.mean_abs_error))}" r="4" fill="#f7f3e8"/>`).join('')}`; }
      function showError(error) { console.error(error); $('loadNotice').innerHTML = `<div class="notice"><strong>Data assets did not load.</strong><br>Run <code>python scripts/11_export_report_assets.py</code> and <code>python scripts/12_prepare_web_assets.py</code>, then restart <code>npm.cmd run dev</code>. Details: ${error.message}</div>`; document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in')); }
      async function main() { try { const [summary, models, regionRes, yearRes, countryRes, completeness, coverage] = await Promise.all(['report_summary','model_comparison','region_residuals','year_residuals','country_residuals_top','data_completeness_by_region','variable_coverage'].map(load)); $('heroLead').textContent = summary.analytical_question; $('datasetMetrics').innerHTML = `<div class="metric"><strong>${fmt(summary.dataset.full_rows)}</strong><span class="metric-label">full country-year rows</span></div><div class="metric"><strong>${fmt(summary.dataset.countries)}</strong><span class="metric-label">countries/entities</span></div><div class="metric"><strong>${summary.dataset.min_year}–${summary.dataset.max_year}</strong><span class="metric-label">historical range</span></div><div class="metric"><strong>${fmt(summary.best_model.test_mae)}</strong><span class="metric-label">TabPFN mean error</span></div>`; bars($('coverageBars'), coverage.slice(0,12), 'variable_name', 'non_null_share', 1); bars($('regionCompleteness'), completeness, 'region', 'mean_completeness'); $('modelComparison').innerHTML = models.map((m) => `<div class="model-row"><div><strong>${labelName(m.model)}</strong><br><small>${fmt(m.test_rows)} test rows</small></div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(4, (1 / Number(m.test_mae)) * 42)}%"></div></div><div class="model-score"><strong>${fmt(m.test_mae)}</strong><small>MAE</small><small>R² ${fmt(m.test_r2)}</small></div></div>`).join(''); const findingPick = ['overall_error','best_region','worst_region','worst_year','positive_outlier','negative_outlier']; $('findingCards').innerHTML = summary.executive_findings.filter((d) => findingPick.includes(d.finding_id)).map((d) => `<article class="finding"><strong>${typeof d.value === 'number' ? fmt(d.value) : d.value}</strong><p><b>${d.metric}</b><br>${d.finding}</p></article>`).join(''); bars($('regionResiduals'), regionRes.sort((a,b) => Number(a.mean_abs_error) - Number(b.mean_abs_error)), 'region', 'mean_abs_error'); drawYearLine($('yearResiduals'), yearRes); document.querySelector('#countryTable tbody').innerHTML = countryRes.slice(0,15).map((d) => `<tr><td>${d.country_code}</td><td>${d.region ?? ''}</td><td>${fmt(d.mean_abs_error)}</td><td>${fmt(d.mean_residual)}</td></tr>`).join(''); const observer = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('in'); }), { threshold: .12 }); document.querySelectorAll('.reveal').forEach((el) => observer.observe(el)); setTimeout(() => document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in')), 400); } catch (error) { showError(error); } }
      main();
    </script>
  </body>
</html>
