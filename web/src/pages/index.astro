<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Global Health Signals | WHO + TabPFN</title>
    <meta name="description" content="Interactive analytical report using WHO Global Health Observatory data and TabPFN to model life expectancy and health-system signals." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root{--bg:#050505;--ink:#f7f3e8;--muted:#a9a39a;--dim:#6f6a63;--line:rgba(247,243,232,.14);--panel:rgba(255,255,255,.045);--green:#d7ff6f;--blue:#9fc8ff;--red:#ff7777}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 82% 8%,rgba(215,255,111,.13),transparent 22%),radial-gradient(circle at 10% 36%,rgba(159,200,255,.10),transparent 26%),var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;background:linear-gradient(rgba(247,243,232,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(247,243,232,.026) 1px,transparent 1px);background-size:80px 80px;pointer-events:none;z-index:-1}a{color:inherit;text-decoration:none}.shell{max-width:1440px;margin:0 auto;padding:28px}.nav{min-height:58px;display:flex;justify-content:space-between;align-items:center;gap:18px;border-bottom:1px solid var(--line);position:sticky;top:0;background:linear-gradient(to bottom,rgba(5,5,5,.96),rgba(5,5,5,.7));backdrop-filter:blur(18px);z-index:20}.brand,.navlinks,.eyebrow,.tag,.metric-label,.chart-note{font-family:'IBM Plex Mono',monospace}.brand{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--green);white-space:nowrap}.navlinks{display:flex;gap:18px;font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700}.hero{min-height:calc(100vh - 86px);display:grid;align-items:end;padding:80px 0 54px}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:800}.hero h1{font-size:clamp(68px,10vw,160px);line-height:.78;letter-spacing:-.095em;margin:22px 0 26px;max-width:1180px}.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1px rgba(247,243,232,.72)}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;border-top:1px solid var(--line);padding-top:24px}.lead{font-size:23px;line-height:1.28;letter-spacing:-.04em;color:#ddd6ca;margin:0}.tags{display:flex;gap:8px;flex-wrap:wrap}.tag{border:1px solid var(--line);border-radius:999px;padding:8px 10px;font-size:11px;text-transform:uppercase;color:var(--muted);background:rgba(255,255,255,.03)}.section{padding:95px 0;border-top:1px solid var(--line)}.section-head{display:grid;grid-template-columns:.45fr 1.55fr;gap:32px;margin-bottom:28px}.section h2{font-size:clamp(42px,6vw,92px);line-height:.9;letter-spacing:-.08em;margin:0}.section-copy{font-size:19px;line-height:1.45;color:var(--muted);margin:0;max-width:760px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric{border:1px solid var(--line);border-radius:24px;padding:22px;background:var(--panel)}.metric strong{display:block;font-size:clamp(34px,4vw,62px);letter-spacing:-.075em;line-height:.9}.metric-label{display:block;margin-top:12px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.panel{border:1px solid var(--line);border-radius:32px;background:linear-gradient(135deg,rgba(255,255,255,.055),rgba(255,255,255,.018));overflow:hidden}.panel-inner{padding:26px}.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.chart-card{border:1px solid var(--line);border-radius:24px;padding:20px;background:rgba(0,0,0,.18);min-height:340px}.chart-card h3{font-size:26px;line-height:1.05;letter-spacing:-.055em;margin:0 0 16px}.bar{display:grid;grid-template-columns:150px 1fr 70px;gap:10px;align-items:center;margin:10px 0}.bar span{font-size:12px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-track{height:11px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden}.bar-fill{height:100%;background:var(--green);border-radius:999px}.bar-value{text-align:right;color:var(--ink)!important}.comparison{display:grid;gap:12px}.model-row{display:grid;grid-template-columns:190px 1fr 80px;gap:12px;align-items:center;border:1px solid var(--line);border-radius:18px;padding:14px;background:rgba(255,255,255,.025)}.model-row strong{font-size:18px}.model-row small{font-family:'IBM Plex Mono';color:var(--muted);font-size:11px}.line-chart{width:100%;height:300px}.residual-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.finding{border:1px solid var(--line);border-radius:22px;padding:20px;background:rgba(0,0,0,.18)}.finding strong{display:block;font-size:34px;letter-spacing:-.07em;color:var(--green)}.finding p{margin:10px 0 0;color:var(--muted);line-height:1.4}.table{width:100%;border-collapse:collapse}.table th,.table td{border-bottom:1px solid var(--line);padding:11px 8px;text-align:left;font-size:13px}.table th{font-family:'IBM Plex Mono';font-size:10px;text-transform:uppercase;color:var(--muted);letter-spacing:.1em}.footer{padding:70px 0 30px;color:var(--muted);border-top:1px solid var(--line)}.notice{border:1px solid var(--red);border-radius:20px;padding:18px;color:#ffd6d6;background:rgba(255,119,119,.08);margin:24px 0}.reveal{opacity:1;transform:none;transition:opacity .7s ease,transform .7s ease}.js .reveal{opacity:0;transform:translateY(22px)}.js .reveal.in{opacity:1;transform:none}@media(max-width:900px){.shell{padding:18px}.nav{height:auto;padding:14px 0;align-items:flex-start;gap:12px;flex-direction:column}.navlinks{overflow-x:auto;gap:10px;width:100%;padding-bottom:4px}.hero{min-height:auto;padding:58px 0}.hero h1{font-size:clamp(52px,15vw,84px)}.hero-grid,.section-head,.metrics,.chart-grid,.residual-grid{grid-template-columns:1fr}.lead{font-size:19px}.section{padding:70px 0}.section h2{font-size:44px}.model-row{grid-template-columns:1fr}.bar{grid-template-columns:92px 1fr 55px}.chart-card{min-height:auto}}
    </style>
  </head>
  <body>
    <script>document.documentElement.classList.add('js');</script>
    <div class="shell">
      <nav class="nav"><a class="brand" href="#top">Global Health Signals</a><div class="navlinks"><a href="#data">Data</a><a href="#model">Model</a><a href="#residuals">Residuals</a><a href="#brief">Brief</a></div></nav>
      <main id="top">
        <section class="hero"><div><p class="eyebrow reveal">WHO GHO Data / TabPFN / Health Intelligence</p><h1 class="reveal">From global health indicators to <em>decision signals.</em></h1><div class="hero-grid reveal"><p class="lead" id="heroLead">Loading analytical summary...</p><div class="tags"><span class="tag">WHO GHO API</span><span class="tag">Life expectancy</span><span class="tag">TabPFN</span><span class="tag">Prior Labs</span><span class="tag">Country-year data</span><span class="tag">Residual intelligence</span></div></div><div id="loadNotice"></div></div></section>
        <section class="section" id="data"><div class="section-head reveal"><p class="eyebrow">01 / Data foundation</p><div><h2>A global dataset with uneven signals.</h2><p class="section-copy">The report starts by treating missingness as information. Coverage gaps are part of the analytical story, not only a cleaning problem.</p></div></div><div class="metrics reveal" id="datasetMetrics"></div><div class="chart-grid reveal" style="margin-top:14px"><div class="chart-card"><h3>Top indicator coverage</h3><div id="coverageBars"></div></div><div class="chart-card"><h3>Completeness by WHO region</h3><div id="regionCompleteness"></div></div></div></section>
        <section class="section" id="model"><div class="section-head reveal"><p class="eyebrow">02 / Prediction layer</p><div><h2>TabPFN moves the model below one year of error.</h2><p class="section-copy">The model comparison uses a temporal test set: older country-year records train the model and 2015 onward tests generalization.</p></div></div><div class="panel reveal"><div class="panel-inner"><div class="comparison" id="modelComparison"></div></div></div></section>
        <section class="section" id="residuals"><div class="section-head reveal"><p class="eyebrow">03 / Residual intelligence</p><div><h2>Outliers reveal where the world behaves differently.</h2><p class="section-copy">Residuals identify countries and years where observed life expectancy is higher or lower than the model expected from the available health-system signals.</p></div></div><div class="residual-grid reveal" id="findingCards"></div><div class="chart-grid reveal" style="margin-top:14px"><div class="chart-card"><h3>Error by region</h3><div id="regionResiduals"></div></div><div class="chart-card"><h3>Error by year</h3><svg class="line-chart" id="yearResiduals" viewBox="0 0 600 300"></svg></div></div></section>
        <section class="section" id="brief"><div class="section-head reveal"><p class="eyebrow">04 / Intelligence brief</p><div><h2>What the first model says.</h2><p class="section-copy">This first version creates the analytical backbone. The next iteration will add maps, country drill-down and a more cinematic scroll sequence.</p></div></div><div class="panel reveal"><div class="panel-inner"><table class="table" id="countryTable"><thead><tr><th>Country</th><th>Region</th><th>Mean error</th><th>Mean residual</th></tr></thead><tbody></tbody></table></div></div></section>
      </main>
      <footer class="footer">Built from WHO Global Health Observatory data. Modeling layer: Prior Labs / TabPFN. Repository: who-global-health-signals.</footer>
    </div>
    <script type="module">
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => Number(n).toLocaleString('en-US', { maximumFractionDigits: 2 });
      const load = async (name) => {
        const response = await fetch(`/data/${name}.json`, { cache: 'no-store' });
        if (!response.ok) throw new Error(`Could not load /data/${name}.json (${response.status})`);
        return response.json();
      };
      function bars(el, data, label, value, max = null) {
        const values = data.map((d) => Number(d[value]) || 0);
        const m = max ?? Math.max(...values, 0.01);
        el.innerHTML = data.map((d) => `<div class="bar"><span title="${d[label] ?? ''}">${String(d[label] ?? '').replaceAll('_', ' ')}</span><div class="bar-track"><div class="bar-fill" style="width:${Math.max(2, ((Number(d[value]) || 0) / m) * 100)}%"></div></div><span class="bar-value">${fmt(Number(d[value]) || 0)}</span></div>`).join('');
      }
      function drawYearLine(svg, data) {
        const w = 600, h = 300, margin = { top: 24, right: 24, bottom: 36, left: 46 };
        const years = data.map((d) => Number(d.year));
        const vals = data.map((d) => Number(d.mean_abs_error));
        const minX = Math.min(...years), maxX = Math.max(...years), maxY = Math.max(...vals) * 1.15;
        const sx = (x) => margin.left + ((x - minX) / Math.max(1, maxX - minX)) * (w - margin.left - margin.right);
        const sy = (y) => h - margin.bottom - (y / Math.max(0.01, maxY)) * (h - margin.top - margin.bottom);
        const points = data.map((d) => `${sx(Number(d.year))},${sy(Number(d.mean_abs_error))}`).join(' ');
        const xTicks = [...new Set(years)].filter((_, i) => i % 2 === 0);
        const yTicks = [0, maxY / 2, maxY];
        svg.innerHTML = `<line x1="${margin.left}" y1="${h-margin.bottom}" x2="${w-margin.right}" y2="${h-margin.bottom}" stroke="rgba(247,243,232,.16)"/><line x1="${margin.left}" y1="${margin.top}" x2="${margin.left}" y2="${h-margin.bottom}" stroke="rgba(247,243,232,.16)"/>${xTicks.map(t=>`<text x="${sx(t)}" y="${h-12}" fill="#a9a39a" font-size="10" text-anchor="middle">${t}</text>`).join('')}${yTicks.map(t=>`<text x="${margin.left-8}" y="${sy(t)+4}" fill="#a9a39a" font-size="10" text-anchor="end">${fmt(t)}</text>`).join('')}<polyline points="${points}" fill="none" stroke="#d7ff6f" stroke-width="2"/>${data.map(d=>`<circle cx="${sx(Number(d.year))}" cy="${sy(Number(d.mean_abs_error))}" r="4" fill="#f7f3e8"/>`).join('')}`;
      }
      function showError(error) {
        console.error(error);
        $('loadNotice').innerHTML = `<div class="notice"><strong>Data assets did not load.</strong><br>Run <code>python scripts/12_prepare_web_assets.py</code> from the repository root, then restart <code>npm.cmd run dev</code>. Details: ${error.message}</div>`;
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      }
      async function main() {
        try {
          const [summary, models, regionRes, yearRes, countryRes, completeness, coverage] = await Promise.all(['report_summary','model_comparison','region_residuals','year_residuals','country_residuals_top','data_completeness_by_region','variable_coverage'].map(load));
          $('heroLead').textContent = summary.analytical_question;
          $('datasetMetrics').innerHTML = `<div class="metric"><strong>${fmt(summary.dataset.full_rows)}</strong><span class="metric-label">full rows</span></div><div class="metric"><strong>${fmt(summary.dataset.countries)}</strong><span class="metric-label">countries/entities</span></div><div class="metric"><strong>${summary.dataset.min_year}–${summary.dataset.max_year}</strong><span class="metric-label">time range</span></div><div class="metric"><strong>${fmt(summary.best_model.test_mae)}</strong><span class="metric-label">TabPFN MAE</span></div>`;
          bars($('coverageBars'), coverage.slice(0,12), 'variable_name', 'non_null_share', 1);
          bars($('regionCompleteness'), completeness, 'region', 'mean_completeness');
          $('modelComparison').innerHTML = models.map((m) => `<div class="model-row"><div><strong>${m.model}</strong><br><small>${fmt(m.test_rows)} test rows</small></div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(4, (1 / Number(m.test_mae)) * 42)}%"></div></div><div><strong>${fmt(m.test_mae)}</strong><br><small>MAE</small></div></div>`).join('');
          const findingPick = ['overall_error','best_region','worst_region','worst_year','positive_outlier','negative_outlier'];
          $('findingCards').innerHTML = summary.executive_findings.filter((d) => findingPick.includes(d.finding_id)).map((d) => `<article class="finding"><strong>${typeof d.value === 'number' ? fmt(d.value) : d.value}</strong><p><b>${d.metric}</b><br>${d.finding}</p></article>`).join('');
          bars($('regionResiduals'), regionRes.sort((a,b) => Number(a.mean_abs_error) - Number(b.mean_abs_error)), 'region', 'mean_abs_error');
          drawYearLine($('yearResiduals'), yearRes);
          document.querySelector('#countryTable tbody').innerHTML = countryRes.slice(0,15).map((d) => `<tr><td>${d.country_code}</td><td>${d.region ?? ''}</td><td>${fmt(d.mean_abs_error)}</td><td>${fmt(d.mean_residual)}</td></tr>`).join('');
          const observer = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('in'); }), { threshold: .12 });
          document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
          setTimeout(() => document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in')), 400);
        } catch (error) {
          showError(error);
        }
      }
      main();
    </script>
  </body>
</html>
