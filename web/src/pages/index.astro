p small{display:block;color:var(--green);font-family:'IBM Plex Mono';font-size:10px;letter-spacing:.12em;text-transform:uppercase}.flow-step strong{display:block;font-size:20px;letter-spacing:-.035em;margin:10px 0}.flow-step span{color:var(--muted);font-size:13px;line-height:1.35}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric{border:1px solid var(--line);border-radius:24px;padding:22px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02))}.metric strong{display:block;font-size:clamp(34px,4vw,62px);letter-spacing:-.05em;line-height:.95}.metric-label{display:block;margin-top:12px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.viz-card{border:1px solid var(--line);border-radius:28px;padding:22px;background:linear-gradient(135deg,rgba(255,255,255,.052),rgba(255,255,255,.016));min-height:430px}.viz-card h3{font-size:25px;line-height:1.05;letter-spacing:-.04em;margin:0 0 8px}.viz-card .explain{color:var(--muted);font-size:14px;line-height:1.44;margin:0 0 18px}.chart-panel{display:grid;grid-template-columns:1fr 220px;gap:16px;align-items:start}.chart-list{display:grid;gap:9px}.chart-row{appearance:none;border:1px solid transparent;background:rgba(255,255,255,.025);border-radius:14px;padding:10px 11px;text-align:left;color:inherit;cursor:pointer;transition:.18s ease}.chart-row:hover,.chart-row.active{border-color:rgba(215,255,111,.42);background:rgba(215,255,111,.07)}.chart-row-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.chart-label{font-size:12.5px;line-height:1.25;color:var(--soft);max-width:78%;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.chart-value{font-family:'IBM Plex Mono';font-size:12px;color:var(--ink);white-space:nowrap}.bar-track{height:9px;background:rgba(255,255,255,.085);border-radius:999px;overflow:hidden;margin-top:8px}.bar-fill{height:100%;background:linear-gradient(90deg,var(--green),rgba(215,255,111,.38));border-radius:999px}.chart-detail{border:1px solid var(--line);border-radius:20px;padding:16px;background:rgba(0,0,0,.24);position:sticky;top:92px}.chart-detail .chart-kicker{color:var(--green);font-size:10px;text-transform:uppercase;letter-spacing:.12em}.chart-detail strong{display:block;font-size:34px;line-height:.95;letter-spacing:-.05em;margin:14px 0 8px}.chart-detail p{margin:0;color:var(--muted);font-size:13px;line-height:1.42}.hint{font-size:10px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin-top:12px}.model-stack{display:grid;gap:12px}.model-row{display:grid;grid-template-columns:180px 1fr 130px;gap:16px;align-items:center;border:1px solid var(--line);border-radius:24px;padding:18px;background:rgba(255,255,255,.03);cursor:pointer}.model-row:first-child{background:linear-gradient(135deg,rgba(215,255,111,.14),rgba(255,255,255,.026));border-color:rgba(215,255,111,.40)}.model-row:hover{border-color:rgba(215,255,111,.42)}.model-row strong{font-size:21px;letter-spacing:-.035em}.model-row small{display:block;color:var(--muted);font-size:11px;margin-top:5px}.model-score{text-align:right}.model-score strong{display:block;color:var(--green);font-size:34px;line-height:.9}.model-score small{font-family:'IBM Plex Mono'}.model-note{font-size:13px;line-height:1.42;color:var(--muted);margin-top:10px}.residual-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.finding{border:1px solid var(--line);border-radius:24px;padding:22px;background:rgba(0,0,0,.20);cursor:pointer}.finding:hover,.finding.active{border-color:rgba(215,255,111,.45);background:rgba(215,255,111,.06)}.finding strong{display:block;font-size:36px;letter-spacing:-.05em;color:var(--green);line-height:.95}.finding p{margin:12px 0 0;color:var(--muted);line-height:1.4}.finding b{color:var(--ink)}.line-chart{width:100%;height:320px}.brief-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.brief{border:1px solid var(--line);border-radius:24px;padding:22px;background:rgba(255,255,255,.035)}.brief h3{font-size:24px;line-height:1.05;letter-spacing:-.04em;margin:0 0 12px}.brief p{color:var(--muted);line-height:1.43;margin:0}.case-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:0 22px 22px}.case-card{border:1px solid var(--line);border-radius:20px;padding:15px;background:rgba(0,0,0,.22);cursor:pointer}.case-card:hover,.case-card.active{border-color:rgba(215,255,111,.45);background:rgba(215,255,111,.06)}.case-rank{font-size:10px;color:var(--green);letter-spacing:.12em}.case-card strong{display:block;font-size:26px;line-height:.9;margin:12px 0 4px}.case-card span{display:block;color:var(--muted);font-size:12px;line-height:1.3}.case-metric{margin-top:12px;display:flex;justify-content:space-between;gap:8px;border-top:1px solid var(--line);padding-top:10px}.case-metric b{font-size:13px}.notice{border:1px solid var(--red);border-radius:20px;padding:18px;color:#ffd6d6;background:rgba(255,119,119,.08);margin:24px 0}.tooltip{position:fixed;z-index:50;max-width:280px;background:#111;border:1px solid var(--line2);border-radius:14px;padding:12px;color:var(--soft);font-size:12px;line-height:1.35;pointer-events:none;opacity:0;transform:translate(-50%,-120%);box-shadow:0 18px 50px rgba(0,0,0,.45)}.tooltip strong{display:block;color:var(--ink);font-size:13px;margin-bottom:4px}.footer{padding:70px 0 30px;color:var(--muted);border-top:1px solid var(--line)}.reveal{opacity:1;transform:none;transition:opacity .7s ease,transform .7s ease}.js .reveal{opacity:0;transform:translateY(22px)}.js .reveal.in{opacity:1;transform:none}@media(max-width:1160px){.section-head{grid-template-columns:1fr}.chapter-label:after{width:160px}.hero-grid,.story-grid,.metrics,.chart-grid,.residual-grid,.brief-grid,.method-flow{grid-template-columns:1fr}.story-text{border-right:0;border-bottom:1px solid var(--line)}.story-text:last-child{border-bottom:0}.flow-step:after{display:none}.case-grid{grid-template-columns:1fr 1fr}.model-row{grid-template-columns:1fr}.model-score{text-align:left}.chart-panel{grid-template-columns:1fr}.chart-detail{position:relative;top:auto}.viz-card{min-height:auto}}@media(max-width:720px){.shell{padding:18px}.nav{height:auto;padding:14px 0;align-items:flex-start;gap:12px;flex-direction:column}.navlinks{overflow-x:auto;gap:10px;width:100%;padding-bottom:4px}.hero{min-height:auto;padding:58px 0}.hero h1{font-size:clamp(50px,15vw,82px);letter-spacing:-.04em}.lead{font-size:19px}.section{padding:70px 0}.section h2{font-size:44px}.case-grid{grid-template-columns:1fr}.chart-row-top{display:grid}.chart-label{max-width:100%}}
    </style>
  </head>
  <body>
    <script>document.documentElement.classList.add('js');</script>
    <div class="shell">
      <nav class="nav"><a class="brand" href="#top">Global Health Signals</a><div class="navlinks"><a href="#question">Question</a><a href="#data">Data</a><a href="#model">Model</a><a href="#residuals">Residuals</a><a href="#brief">Brief</a></div></nav>
      <main id="top">
        <section class="hero"><div><p class="eyebrow reveal">WHO GHO Data / TabPFN / Health Intelligence</p><h1 class="reveal">From public health data to <em>predictive evidence.</em></h1><div class="hero-grid reveal"><p class="lead" id="heroLead">Can public health indicators from WHO explain and predict differences in life expectancy across countries?</p><div class="executive-note"><p>This report converts heterogeneous WHO country-year indicators into a modeling layer, then asks whether a tabular foundation model can recover a meaningful life-expectancy signal. The value is not only the score: the residuals show where countries depart from the pattern expected by the available data.</p><div class="tags"><span class="tag">WHO GHO API</span><span class="tag">Life expectancy</span><span class="tag">TabPFN</span><span class="tag">Prior Labs</span><span class="tag">Interactive residuals</span></div></div></div><div id="loadNotice"></div></div></section>

        <section class="section" id="question"><div class="section-head reveal"><span class="chapter-label">00 / Analytical architecture</span><div><h2>A country-year prediction problem, not a generic dashboard.</h2><p class="section-copy">The unit of analysis is a country in a year. The target is life expectancy at birth. The features are mortality, immunization, expenditure, disease and data-quality indicators from WHO. The purpose is to test signal strength, benchmark model performance and identify records that deserve policy-context follow-up.</p></div></div><div class="method-flow reveal"><div class="flow-step"><small>01</small><strong>Acquire</strong><span>Pull public indicators from the WHO GHO OData API.</span></div><div class="flow-step"><small>02</small><strong>Structure</strong><span>Convert indicators into a country-year analytical table.</span></div><div class="flow-step"><small>03</small><strong>Audit</strong><span>Measure coverage, missingness and modeling readiness.</span></div><div class="flow-step"><small>04</small><strong>Model</strong><span>Compare Ridge, Random Forest and TabPFN on a temporal split.</span></div><div class="flow-step"><small>05</small><strong>Interpret</strong><span>Use residuals to find countries above or below expected outcomes.</span></div></div></section>

        <section class="section" id="data"><div class="section-head reveal"><span class="chapter-label">01 / Data foundation</span><div><h2>The dataset is global, but not equally complete.</h2><p class="section-copy">The first analytical decision is to keep data quality visible. Coverage is not just a preprocessing concern: it changes how much confidence we should place in cross-country comparisons and helps explain why some regions or countries are harder to model.</p></div></div><div class="metrics reveal" id="datasetMetrics"></div><div class="chart-grid reveal"><div class="viz-card"><h3>Variable coverage profile</h3><p class="explain">Click a row to inspect coverage. Higher coverage means the indicator appears in more country-year rows and is more stable for cross-country modeling.</p><div class="chart-panel"><div class="chart-list" id="coverageBars"></div><aside class="chart-detail" id="coverageDetail"></aside></div></div><div class="viz-card"><h3>Completeness by WHO region</h3><p class="explain">Click a region to inspect its average data completeness. This is a governance signal, not a performance ranking.</p><div class="chart-panel"><div class="chart-list" id="regionCompleteness"></div><aside class="chart-detail" id="completenessDetail"></aside></div></div></div></section>

        <section class="section" id="model"><div class="section-head reveal"><span class="chapter-label">02 / Model benchmark</span><div><h2>TabPFN is the only model below one year of average error.</h2><p class="section-copy">The split is temporal: records before 2015 train the models, and records from 2015 onward test them. This prevents the report from only measuring fit on historical data and makes the result closer to a forward-looking evaluation.</p></div></div><div class="story-card reveal"><div class="story-grid"><div class="story-text"><h3>Executive reading</h3><p><b>MAE</b> is the average absolute difference between predicted and observed life expectancy. A value of 0.94 means the TabPFN estimate missed the observed outcome by less than one year on average.</p><p><b>R²</b> measures explained variation. TabPFN reached 0.96 on the recent test set, compared with 0.88 for Random Forest and 0.76 for Ridge.</p><p>The comparison matters because it shows the gain is not simply a product of the dataset. The tabular foundation model extracts more usable structure from the same input table.</p></div><div class="story-text"><div class="model-stack" id="modelComparison"></div></div></div></div></section>

        <section class="section" id="residuals"><div class="section-head reveal"><span class="chapter-label">03 / Residual intelligence</span><div><h2>The error layer is where the report becomes investigative.</h2><p class="section-copy">Residuals are calculated as observed minus predicted life expectancy. Positive residuals indicate performance above the model expectation; negative residuals indicate outcomes below what the available indicators suggested. These are not labels of success or failure. They are leads for deeper analysis.</p></div></div><div class="residual-grid reveal" id="findingCards"></div><div class="chart-grid reveal"><div class="viz-card"><h3>Regional model difficulty</h3><p class="explain">Click a region to compare mean absolute prediction error. Higher error suggests the model needs more local context.</p><div class="chart-panel"><div class="chart-list" id="regionResiduals"></div><aside class="chart-detail" id="residualDetail"></aside></div></div><div class="viz-card"><h3>Temporal stress point</h3><p class="explain">Hover the points. Error rises in 2021, suggesting a stress period where mortality patterns shifted faster than the selected features could summarize.</p><svg class="line-chart" id="yearResiduals" viewBox="0 0 600 320"></svg></div></div></section>

        <section class="section" id="brief"><div class="section-head reveal"><span class="chapter-label">04 / Intelligence brief</span><div><h2>What the first version already supports.</h2><p class="section-copy">The first result is strong enough to support a concise executive conclusion: WHO indicators contain predictive signal for life expectancy, TabPFN improves the benchmark, and the most valuable next layer is a country-level residual investigation.</p></div></div><div class="brief-grid reveal"><article class="brief"><h3>Conclusion</h3><p>Public health indicators can estimate recent life expectancy with high accuracy when structured as a country-year tabular problem.</p></article><article class="brief"><h3>Risk</h3><p>Data completeness remains uneven. Any executive use of the model should keep the coverage layer visible beside predictions.</p></article><article class="brief"><h3>Next analysis</h3><p>Eswatini, Kuwait 2021 and high-error regional clusters should become case cards with local context and indicator trajectories.</p></article></div><div class="story-card reveal" style="margin-top:14px"><div class="story-text" style="border-right:0;border-bottom:1px solid var(--line)"><h3>Highest-error country profiles</h3><p>Click a card to inspect the case. A high error can reflect a true shock, missing variables, country-specific dynamics, or indicator lag.</p></div><div class="case-grid" id="countryCases"></div></div></section>
      </main>
      <footer class="footer">Built from WHO Global Health Observatory data. Modeling layer: Prior Labs / TabPFN. Repository: who-global-health-signals.</footer>
    </div>
    <div class="tooltip" id="tooltip"></div>
    <script type="module">
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => Number(n).toLocaleString('en-US', { maximumFractionDigits: 2 });
      const pct = (n) => `${Math.round(Number(n) * 100)}%`;
      const labelName = (s) => String(s ?? '').replaceAll('_', ' ').replace(/\b\w/g, c => c.toUpperCase());
      const load = async (name) => { const response = await fetch(`/data/${name}.json`, { cache: 'no-store' }); if (!response.ok) throw new Error(`Could not load /data/${name}.json (${response.status})`); return response.json(); };
      const tooltip = $('tooltip');
      function showTip(html, event){ tooltip.innerHTML = html; tooltip.style.left = `${event.clientX}px`; tooltip.style.top = `${event.clientY}px`; tooltip.style.opacity = 1; }
      function hideTip(){ tooltip.style.opacity = 0; }
      function setDetail(el, kicker, title, body, value){ el.innerHTML = `<span class="chart-kicker">${kicker}</span><strong>${value}</strong><p><b>${title}</b><br>${body}</p><div class="hint">Click rows to update</div>`; }
      function interactiveBars({el, detail, data, label, value, max=null, formatter=fmt, detailText}) { const values = data.map(d => Number(d[value]) || 0); const m = max ?? Math.max(...values, .01); el.innerHTML = data.map((d,i) => `<button class="chart-row ${i===0?'active':''}" type="button" data-index="${i}"><div class="chart-row-top"><span class="chart-label">${labelName(d[label])}</span><span class="chart-value">${formatter(Number(d[value]) || 0)}</span></div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(3, ((Number(d[value]) || 0) / m) * 100)}%"></div></div></button>`).join(''); const update = (i) => { const d = data[i]; el.querySelectorAll('.chart-row').forEach(btn => btn.classList.toggle('active', Number(btn.dataset.index)===i)); setDetail(detail, 'Selected signal', labelName(d[label]), detailText(d), formatter(Number(d[value]) || 0)); }; el.querySelectorAll('.chart-row').forEach(btn => { btn.addEventListener('click', () => update(Number(btn.dataset.index))); btn.addEventListener('mousemove', e => { const d = data[Number(btn.dataset.index)]; showTip(`<strong>${labelName(d[label])}</strong>${detailText(d)}`, e); }); btn.addEventListener('mouseleave', hideTip); }); update(0); }
      function drawYearLine(svg, data) { const w = 600, h = 320, margin = { top: 28, right: 28, bottom: 42, left: 52 }; const years = data.map(d => Number(d.year)); const vals = data.map(d => Number(d.mean_abs_error)); const minX = Math.min(...years), maxX = Math.max(...years), maxY = Math.max(...vals) * 1.18; const sx = x => margin.left + ((x - minX) / Math.max(1, maxX - minX)) * (w - margin.left - margin.right); const sy = y => h - margin.bottom - (y / Math.max(.01, maxY)) * (h - margin.top - margin.bottom); const points = data.map(d => `${sx(Number(d.year))},${sy(Number(d.mean_abs_error))}`).join(' '); const xTicks = [...new Set(years)].filter((_, i) => i % 2 === 0); const yTicks = [0, maxY/2, maxY]; svg.innerHTML = `<rect x="0" y="0" width="600" height="320" fill="rgba(255,255,255,.012)" rx="18"/>${yTicks.map(t=>`<line x1="${margin.left}" y1="${sy(t)}" x2="${w-margin.right}" y2="${sy(t)}" stroke="rgba(248,243,232,.08)"/><text x="${margin.left-8}" y="${sy(t)+4}" fill="#a8a095" font-size="10" text-anchor="end">${fmt(t)}</text>`).join('')}<line x1="${margin.left}" y1="${h-margin.bottom}" x2="${w-margin.right}" y2="${h-margin.bottom}" stroke="rgba(248,243,232,.18)"/><line x1="${margin.left}" y1="${margin.top}" x2="${margin.left}" y2="${h-margin.bottom}" stroke="rgba(248,243,232,.18)"/>${xTicks.map(t=>`<text x="${sx(t)}" y="${h-14}" fill="#a8a095" font-size="10" text-anchor="middle">${t}</text>`).join('')}<polyline points="${points}" fill="none" stroke="#d7ff6f" stroke-width="2.6"/>${data.map((d,i)=>`<g class="year-point" data-index="${i}" style="cursor:pointer"><circle cx="${sx(Number(d.year))}" cy="${sy(Number(d.mean_abs_error))}" r="13" fill="rgba(215,255,111,.08)"/><circle cx="${sx(Number(d.year))}" cy="${sy(Number(d.mean_abs_error))}" r="4.8" fill="#f8f3e8"/></g>`).join('')}`; svg.querySelectorAll('.year-point').forEach(g => { g.addEventListener('mousemove', e => { const d = data[Number(g.dataset.index)]; showTip(`<strong>${d.year}</strong>Mean error: ${fmt(d.mean_abs_error)} years<br>Countries: ${fmt(d.countries)}`, e); }); g.addEventListener('mouseleave', hideTip); }); }
      function showError(error) { console.error(error); $('loadNotice').innerHTML = `<div class="notice"><strong>Data assets did not load.</strong><br>Run <code>python scripts/11_export_report_assets.py</code> and <code>python scripts/12_prepare_web_assets.py</code>, then restart <code>npm.cmd run dev</code>. Details: ${error.message}</div>`; document.querySelectorAll('.reveal').forEach(el => el.classList.add('in')); }
      async function main() { try { const [summary, models, regionRes, yearRes, countryRes, completeness, coverage] = await Promise.all(['report_summary','model_comparison','region_residuals','year_residuals','country_residuals_top','data_completeness_by_region','variable_coverage'].map(load)); $('heroLead').textContent = summary.analytical_question; $('datasetMetrics').innerHTML = `<div class="metric"><strong>${fmt(summary.dataset.full_rows)}</strong><span class="metric-label">country-year rows</span></div><div class="metric"><strong>${fmt(summary.dataset.countries)}</strong><span class="metric-label">countries/entities</span></div><div class="metric"><strong>${summary.dataset.min_year}–${summary.dataset.max_year}</strong><span class="metric-label">historical range</span></div><div class="metric"><strong>${fmt(summary.best_model.test_mae)}</strong><span class="metric-label">TabPFN MAE years</span></div>`;
          interactiveBars({el:$('coverageBars'),detail:$('coverageDetail'),data:coverage.slice(0,10),label:'variable_name',value:'non_null_share',max:1,formatter:pct,detailText:d=>`Coverage in the country-year table: ${pct(d.non_null_share)}. Missing share: ${pct(d.missing_share)}.`});
          interactiveBars({el:$('regionCompleteness'),detail:$('completenessDetail'),data:completeness,label:'region',value:'mean_completeness',formatter:pct,detailText:d=>`Average data completeness: ${pct(d.mean_completeness)} across ${fmt(d.countries)} countries and ${fmt(d.rows)} country-year rows.`});
          const maxMae = Math.max(...models.map(m => Number(m.test_mae))); $('modelComparison').innerHTML = models.map((m,i) => `<article class="model-row" data-index="${i}"><div><strong>${labelName(m.model)}</strong><small>${fmt(m.test_rows)} recent test rows</small></div><div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(5, (1 - Number(m.test_mae) / maxMae) * 82 + 18)}%"></div></div><p class="model-note">RMSE ${fmt(m.test_rmse)} · R² ${fmt(m.test_r2)}</p></div><div class="model-score"><strong>${fmt(m.test_mae)}</strong><small>MAE years</small></div></article>`).join(''); $('modelComparison').querySelectorAll('.model-row').forEach(row => row.addEventListener('mousemove', e => { const m = models[Number(row.dataset.index)]; showTip(`<strong>${labelName(m.model)}</strong>MAE ${fmt(m.test_mae)} years<br>RMSE ${fmt(m.test_rmse)}<br>R² ${fmt(m.test_r2)}`, e); })); $('modelComparison').addEventListener('mouseleave', hideTip);
          const findingPick = ['overall_error','best_region','worst_region','worst_year','positive_outlier','negative_outlier']; $('findingCards').innerHTML = summary.executive_findings.filter(d => findingPick.includes(d.finding_id)).map((d,i) => `<article class="finding" data-index="${i}"><strong>${typeof d.value === 'number' ? fmt(d.value) : d.value}</strong><p><b>${d.metric}</b><br>${d.finding}</p></article>`).join('');
          interactiveBars({el:$('regionResiduals'),detail:$('residualDetail'),data:regionRes.sort((a,b)=>Number(a.mean_abs_error)-Number(b.mean_abs_error)),label:'region',value:'mean_abs_error',formatter:fmt,detailText:d=>`Mean absolute prediction error: ${fmt(d.mean_abs_error)} years. Rows: ${fmt(d.rows)}. Countries: ${fmt(d.countries)}.`});
          drawYearLine($('yearResiduals'), yearRes);
          $('countryCases').innerHTML = countryRes.slice(0,10).map((d,i) => `<article class="case-card" data-index="${i}"><span class="case-rank">#${String(i+1).padStart(2,'0')}</span><strong>${d.country_code}</strong><span>${d.region ?? 'Unknown region'}</span><div class="case-metric"><span>mean error</span><b>${fmt(d.mean_abs_error)}</b></div><div class="case-metric"><span>residual</span><b>${fmt(d.mean_residual)}</b></div></article>`).join(''); $('countryCases').querySelectorAll('.case-card').forEach(card => card.addEventListener('click', () => { $('countryCases').querySelectorAll('.case-card').forEach(c => c.classList.remove('active')); card.classList.add('active'); }));
          const observer = new IntersectionObserver(entries => entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('in'); }), { threshold:.12 }); document.querySelectorAll('.reveal').forEach(el => observer.observe(el)); setTimeout(() => document.querySelectorAll('.reveal').forEach(el => el.classList.add('in')), 400); } catch(error) { showError(error); } }
      main();
    </script>
  </body>
</html>
