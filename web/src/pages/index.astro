    <style>
      :root{--bg:#050505;--ink:#f8f3e8;--soft:#ded6c8;--muted:#a7a096;--line:rgba(248,243,232,.15);--line2:rgba(248,243,232,.28);--green:#d7ff6f;--blue:#9fc8ff;--red:#ff8a7a;--panel:rgba(255,255,255,.045)}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 84% 7%,rgba(215,255,111,.12),transparent 22%),radial-gradient(circle at 8% 32%,rgba(159,200,255,.09),transparent 28%),var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;background:linear-gradient(rgba(248,243,232,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(248,243,232,.024) 1px,transparent 1px);background-size:78px 78px;pointer-events:none;z-index:-1}a{color:inherit;text-decoration:none}.mono,.brand,.navlinks,.eyebrow,.tag,.metric-label,.chapter-label,.chart-kicker,.case-rank,.hint{font-family:'IBM Plex Mono',monospace}.shell{max-width:1480px;margin:0 auto;padding:28px}.nav{min-height:64px;display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid var(--line);position:sticky;top:0;background:linear-gradient(to bottom,rgba(5,5,5,.98),rgba(5,5,5,.78));backdrop-filter:blur(18px);z-index:20}.brand{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--green);white-space:nowrap}.navlinks{display:flex;gap:18px;font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700}.hero{min-height:calc(100vh - 92px);display:grid;align-items:end;padding:86px 0 58px}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:800}.hero h1{font-size:clamp(58px,9vw,138px);line-height:.84;letter-spacing:-.06em;margin:22px 0 28px;max-width:1220px}.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1px rgba(248,243,232,.72)}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;border-top:1px solid var(--line)