    <style>
      :root{--bg:#050505;--ink:#f7f3e8;--soft:#d8d0c3;--muted:#9d958b;--faint:#6f685f;--line:rgba(247,243,232,.14);--line2:rgba(247,243,232,.26);--panel:#0b0b0a;--green:#d7ff6f;--blue:#9fc8ff;--red:#ff8a7a}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 78% 8%,rgba(215,255,111,.10),transparent 22%),radial-gradient(circle at 5% 35%,rgba(159,200,255,.08),transparent 26%),var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;background:linear-gradient(rgba(247,243,232,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(247,243,232,.022) 1px,transparent 1px);background-size:80px 80px;z-index:-1}.mono,.brand,.navlinks,.eyebrow,.chapter,.tag,.small,.rank{font-family:'IBM Plex Mono',monospace}.shell{max-width:1480px;margin:0 auto;padding:28px}.nav{height:64px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20;background:rgba(5,5,5,.82);backdrop-filter:blur(18px)}.brand{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--green)}.navlinks{display:flex;gap:18px;font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:700}.nav a{color:inherit;text-decoration:none}.hero{min-height:calc(100vh - 92px);display:grid;align-items:end;padding:84px 0 58px}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:800}.hero h1{font-size:clamp(58px,8.6vw,132px);line-height:.86;letter-spacing:-.055em;margin:22px 0 28px;max-width:1200px}.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1px rgba(247,243,232,.72)}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;border-top:1px solid var(--line);padding-top:22px}.lead{font-size:24px;line-height:1.28;letter-spacing:-.025em;color:#e6ded1;margin:0}.note-card{border:1px solid var(--line);border-radius:28px;padding:22px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.018))}.note-card p{margin:0;color:var(--soft);line-height:1.5;font-size:15.5px}.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tag{border:1px solid var(--line);border-radius:999px;padding:8px 10px;font-size:11px;text-transform:uppercase;color:var(--muted);background:rgba(255,255,255,.025)}.section{padding:90px 0;border-top:1px solid var(--line)}.section-head{display:grid;grid-template-columns:250px 1fr;gap:36px;margin-bottom:30px}.chapter{display:block;color:var(--green);font-size:11px;text-transform:uppercase;letter-spacing:.12em;line-height:1.5;padding-top:8px}.chapter:after{content:"";display:block;width:100%;height:1px;background:var(--line);margin-top:18px}.section h2{font-size:clamp(40px,5.05vw,78px);line-height:.98;letter-spacing:-.04em;margin:0;max-width:1020px}.section-copy{font-size:19px;line-height:1.5;color:var(--muted);margin:18px 0 0;max-width:900px}.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.flow-step{border:1px solid var(--line);border-radius:22px;padding:18px;background:rgba(255,255,255,.025);min-height:126px;position:relative}.flow-step:not(:last-child):after{content:"→";position:absolute;right:-13px;top:44%;color:var(--green);font-family:'IBM Plex Mono';z-index:2}.flow-step small{color:var(--green);font-family:'IBM Plex Mono';font-size:10px;letter-spacing:.12em;text-transform:uppercase}.flow-step strong{display:block;font-size:20px;margin:10px 0 6px;letter-spacing:-.035em}.flow-step span{color:var(--muted);font-size:13px;line-height:1.35}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}.metric{border:1px solid var(--line);border-radius:24px;padding:20px;background:linear-gradient(135deg,rgba(255,255,255,.055),rgba(255,255,255,.015))}.metric .num{display:block;font-size:clamp(32px,3.6vw,54px);line-height:.95;letter-spacing:-.04em;font-weight:900}.metric .label{display:block;margin-top:12px;color:var(--muted);font-size:10px;letter-spacing:.1em;text-transform:uppercase}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.panel{border:1px solid var(--line);border-radius:28px;background:linear-gradient(135deg,rgba(255,255,255,.05),rgba(255,255,255,.016));overflow:hidden}.panel-pad{padding:22px}.panel h3{font-size:25px;line-height:1.05;letter-spacing:-.035em;margin:0 0 8px}.explain{color:var(--muted);font-size:14px;line-height:1.44;margin:0 0 18px}.viz-layout{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:16px}.viz-list{display:grid;gap:8px}.viz-item{border:1px solid rgba(247,243,232,.10);border-radius:16px;padding:11px 12px;background:#090908;cursor:pointer;transition:.18s}.viz-item:hover,.viz-item.active{border-color:rgba(215,255,111,.46);background:rgba(215,255,111,.055)}.viz-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.viz-label{color:var(--soft);font-size:12.5px;line-height:1.25;max-width:78%;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.viz-value{font-family:'IBM Plex Mono';font-size:12px;color:var(--green);white-space:nowrap}.track{height:8px;background:rgba(247,243,232,.08);border-radius:999px;overflow:hidden;margin-top:8px}.fill{height:100%;background:linear-gradient(90deg,var(--green),rgba(215,255,111,.35));border-radius:999px}.detail{border:1px solid var(--line);border-radius:22px;padding:16px;background:rgba(0,0,0,.24);min-height:210px}.detail .kicker{font-family:'IBM Plex Mono';color:var(--green);font-size:10px;text-transform:uppercase;letter-spacing:.12em}.detail .big{display:block;font-size:38px;line-height:.95;font-weight:900;letter-spacing:-.04em;color:var(--ink);margin:14px 0 8px}.detail p{margin:0;color:var(--muted);font-size:13px;line-height:1.42}.hint{font-family:'IBM Plex Mono';font-size:10px;color:var(--faint);letter-spacing:.08em;text-transform:uppercase;margin-top:12px}.story{display:grid;grid-template-columns:1fr 1fr}.story>div{padding:28px}.story>div:first-child{border-right:1px solid var(--line)}.story h3{font-size:30px;line-height:1.04;letter-spacing:-.035em;margin:0 0 14px}.story p{margin:0 0 14px;color:var(--soft);line-height:1.52;font-size:16px}.model-stack{display:grid;gap:12px}.model-row{display:grid;grid-template-columns:180px 1fr 118px;gap:16px;align-items:center;border:1px solid var(--line);border-radius:22px;padding:16px;background:#090908;cursor:pointer}.model-row:first-child{background:linear-gradient(135deg,rgba(215,255,111,.13),rgba(255,255,255,.025));border-color:rgba(215,255,111,.42)}.model-row:hover{border-color:rgba(215,255,111,.42)}.model-row strong{display:block;font-size:20px;letter-spacing:-.03em}.model-row small{display:block;color:var(--muted);font-size:11px;margin-top:5px}.model-score{text-align:right}.model-score .num{display:block;color:var(--green);font-size:32px;font-weight:900;line-height:.95}.model-note{font-size:13px;color:var(--muted);line-height:1.42;margin:8px 0 0}.findings{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.finding{border:1px solid var(--line);border-radius:22px;padding:20px;background:#090908}.finding strong{display:block;color:var(--green);font-size:32px;letter-spacing:-.035em;line-height:1}.finding p{margin:10px 0 0;color:var(--muted);line-height:1.4}.finding b{color:var(--ink)}.line-chart{width:100%;height:320px}.brief-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.brief{border:1px solid var(--line);border-radius:22px;padding:20px;background:#090908}.brief h3{font-size:24px;line-height:1.05;letter-spacing:-.035em;margin:0 0 12px}.brief p{color:var(--muted);line-height:1.45;margin:0}.case-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:0 22px 22px}.case-card{border:1px solid var(--line);border-radius:18px;padding:14px;background:#090908;cursor:pointer}.case-card:hover,.case-card.active{border-color:rgba(215,255,111,.45);background:rgba(215,255,111,.055)}.rank{font-size:10px;color:var(--green);letter-spacing:.12em}.case-card strong{display:block;font-size:26px;line-height:.95;margin:12px 0 5px}.case-card span{display:block;color:var(--muted);font-size:12px;line-height:1.3}.case-metric{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line);padding-top:9px;margin-top:10px}.case-metric b{font-size:13px}.tooltip{position:fixed;z-index:50;max-width:280px;background:#111;border:1px solid var(--line2);border-radius:14px;padding:12px;color:var(--soft);font-size:12px;line-height:1.35;pointer-events:none;opacity:0;transform:translate(-50%,-120%);box-shadow:0 18px 50px rgba(0,0,0,.45)}.tooltip strong{display:block;color:var(--ink);font-size:13px;margin-bottom:4px}.notice{border:1px solid var(--red);border-radius:20px;padding:18px;color:#ffd6d6;background:rgba(255,119,119,.08);margin:24px 0}.footer{padding:70px 0 30px;color:var(--muted);border-top:1px solid var(--line)}.reveal{opacity:1;transform:none;transition:opacity .7s,transform .7s}.js .reveal{opacity:0;transform:translateY(22px)}.js .reveal.in{opacity:1;transform:none}@media(max-width:1160px){.section-head,.hero-grid,.grid2,.story,.metrics,.findings,.brief-grid,.flow{grid-template-columns:1fr}.chapter:after{width:160px}.flow-step:after{display:none}.story>div:first-child{border-right:0;border-bottom:1px solid var(--line)}.viz-layout{grid-template-columns:1fr}.case-grid{grid-template-columns:1fr 1fr}.model-row{grid-template-columns:1fr}.model-score{text-align:left}}@media(max-width:720px){.shell{padding:18px}.nav{height:auto;padding:14px 0;align-items:flex-start;gap:12px;flex-direction:column}.navlinks{overflow-x:auto;gap:10px;width:100%;padding-bottom:4px}.hero{min-height:auto;padding:58px 0}.hero h1{font-size:clamp(50px,15vw,82px);letter-spacing:-.035em}.lead{font-size:19px}.section{padding:70px 0}.section h2{font-size:44px}.case-grid{grid-template-columns:1fr}.viz-top{display:grid}.viz-label{max-width:100%}}
    </style>
