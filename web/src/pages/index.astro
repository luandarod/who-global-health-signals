---
import { readFileSync } from 'node:fs';
import MetricCards from '../components/MetricCards.svelte';
import BarInsightChart from '../components/BarInsightChart.svelte';
import ModelComparison from '../components/ModelComparison.svelte';
import ResidualFindings from '../components/ResidualFindings.svelte';
import LineStressChart from '../components/LineStressChart.svelte';
import CountryCaseGrid from '../components/CountryCaseGrid.svelte';

function readJson(name) {
  const fileUrl = new URL(`../../public/data/${name}.json`, import.meta.url);
  return JSON.parse(readFileSync(fileUrl, 'utf-8'));
}

const summary = readJson('report_summary');
const models = readJson('model_comparison');
const regionResiduals = readJson('region_residuals');
const yearResiduals = readJson('year_residuals');
const countryResiduals = readJson('country_residuals_top');
const completeness = readJson('data_completeness_by_region');
const coverage = readJson('variable_coverage');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Global Health Signals | WHO + TabPFN</title>
    <meta name="description" content="Executive analytical report using WHO Global Health Observatory data and TabPFN to model life expectancy, data quality and residual signals." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root { --bg:#050505; --ink:#f7f3e8; --soft:#d8d0c3; --muted:#9d958b; --faint:#6f685f; --line:rgba(247,243,232,.14); --line2:rgba(247,243,232,.26); --green:#d7ff6f; --blue:#9fc8ff; }
      * { box-sizing: border-box; }
      html { background: var(--bg); scroll-behavior: smooth; }
      body { margin: 0; background: radial-gradient(circle at 78% 8%, rgba(215,255,111,.10), transparent 22%), radial-gradient(circle at 5% 35%, rgba(159,200,255,.08), transparent 26%), var(--bg); color: var(--ink); font-family: Inter, system-ui, sans-serif; overflow-x: hidden; }
      body:before { content: ""; position: fixed; inset: 0; background: linear-gradient(rgba(247,243,232,.022) 1px, transparent 1px), linear-gradient(90deg, rgba(247,243,232,.022) 1px, transparent 1px); background-size: 80px 80px; z-index: -1; }
      .mono, .brand, .navlinks, .eyebrow, .chapter, .tag, .source-kicker, .source-link { font-family: 'IBM Plex Mono', monospace; }
      .topbar { position: sticky; top: 0; z-index: 20; width: 100%; border-bottom: 1px solid var(--line); background: rgba(5,5,5,.88); backdrop-filter: blur(18px); }
      .topbar-inner { max-width: 1480px; height: 66px; margin: 0 auto; padding: 0 28px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
      .brand { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--green); white-space: nowrap; }
      .navlinks { display: flex; gap: 14px; font-size: 10.5px; text-transform: uppercase; letter-spacing: .11em; color: var(--muted); font-weight: 700; }
      .navlinks a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 9px; border: 1px solid transparent; border-radius: 999px; }
      .navlinks a:hover { color: var(--ink); border-color: var(--line); background: rgba(255,255,255,.025); }
      .navlinks small { color: var(--green); font-size: 10px; }
      a { color: inherit; text-decoration: none; }
      .shell { max-width: 1480px; margin: 0 auto; padding: 0 28px 28px; }
      .hero { min-height: calc(100vh - 66px); display: grid; align-items: end; padding: 84px 0 58px; }
      .eyebrow { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--green); font-weight: 800; }
      .hero h1 { font-size: clamp(58px, 8.6vw, 132px); line-height: .86; letter-spacing: -.055em; margin: 22px 0 28px; max-width: 1200px; }
      .hero h1 em { font-style: normal; color: transparent; -webkit-text-stroke: 1px rgba(247,243,232,.72); }
      .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 18px; border-top: 1px solid var(--line); padding-top: 22px; }
      .lead { font-size: 24px; line-height: 1.28; letter-spacing: -.025em; color: #e6ded1; margin: 0; }
      .note-card { border: 1px solid var(--line); border-radius: 28px; padding: 22px; background: linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.018)); }
      .note-card p { margin: 0; color: var(--soft); line-height: 1.5; font-size: 15.5px; }
      .tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
      .tag { border: 1px solid var(--line); border-radius: 999px; padding: 8px 10px; font-size: 11px; text-transform: uppercase; color: var(--muted); background: rgba(255,255,255,.025); }
      .section { padding: 90px 0; border-top: 1px solid var(--line); scroll-margin-top: 82px; }
      .section-head { display: grid; grid-template-columns: 250px 1fr; gap: 36px; margin-bottom: 30px; }
      .chapter { display: block; color: var(--green); font-size: 11px; text-transform: uppercase; letter-spacing: .12em; line-height: 1.5; padding-top: 8px; }
      .chapter:after { content: ""; display: block; width: 100%; height: 1px; background: var(--line); margin-top: 18px; }
      .section h2 { font-size: clamp(40px, 5.05vw, 78px); line-height: .98; letter-spacing: -.04em; margin: 0; max-width: 1020px; }
      .section-copy { font-size: 19px; line-height: 1.5; color: var(--muted); margin: 18px 0 0; max-width: 900px; }
      .flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
      .flow-step { border: 1px solid var(--line); border-radius: 22px; padding: 18px; background: rgba(255,255,255,.025); min-height: 126px; position: relative; }
      .flow-step:not(:last-child):after { content: "→"; position: absolute; right: -13px; top: 44%; color: var(--green); font-family: 'IBM Plex Mono'; z-index: 2; }
      .flow-step small { color: var(--green); font-family: 'IBM Plex Mono'; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
      .flow-step strong { display: block; font-size: 20px; margin: 10px 0 6px; letter-spacing: -.035em; }
      .flow-step span { color: var(--muted); font-size: 13px; line-height: 1.35; }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .panel { border: 1px solid var(--line); border-radius: 28px; background: linear-gradient(135deg, rgba(255,255,255,.05), rgba(255,255,255,.016)); overflow: hidden; }
      .panel-pad { padding: 22px; }
      .story { display: grid; grid-template-columns: .85fr 1.15fr; }
      .story > div { padding: 28px; }
      .story > div:first-child { border-right: 1px solid var(--line); }
      .story h3, .panel h3 { font-size: 30px; line-height: 1.04; letter-spacing: -.035em; margin: 0 0 14px; }
      .story p, .explain { margin: 0 0 14px; color: var(--soft); line-height: 1.52; font-size: 16px; }
      .brief-grid, .source-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .brief, .source-card { border: 1px solid var(--line); border-radius: 22px; padding: 20px; background: #090908; }
      .brief h3, .source-card h3 { font-size: 24px; line-height: 1.05; letter-spacing: -.035em; margin: 0 0 12px; }
      .brief p, .source-card p, .source-card li { color: var(--muted); line-height: 1.45; margin: 0; }
      .source-card ul { margin: 12px 0 0; padding-left: 18px; }
      .source-card li + li { margin-top: 8px; }
      .source-kicker { display: block; color: var(--green); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 12px; }
      .source-link { display: inline-flex; margin-top: 16px; color: var(--green); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
      .decision-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 14px; }
      .decision { border: 1px solid var(--line); border-radius: 20px; padding: 16px; background: rgba(255,255,255,.022); }
      .decision strong { display: block; font-size: 18px; margin-bottom: 8px; }
      .decision span { color: var(--muted); font-size: 13px; line-height: 1.4; }
      .footer { padding: 70px 0 30px; color: var(--muted); border-top: 1px solid var(--line); }
      @media (max-width: 1160px) { .topbar-inner { height: auto; min-height: 66px; align-items: flex-start; flex-direction: column; padding-top: 14px; padding-bottom: 14px; } .navlinks { width: 100%; overflow-x: auto; padding-bottom: 4px; } .section-head, .hero-grid, .grid2, .story, .brief-grid, .source-grid, .decision-grid, .flow { grid-template-columns: 1fr; } .chapter:after { width: 160px; } .flow-step:after { display: none; } .story > div:first-child { border-right: 0; border-bottom: 1px solid var(--line); } }
      @media (max-width: 720px) { .shell { padding: 0 18px 18px; } .topbar-inner { padding-left: 18px; padding-right: 18px; } .hero { min-height: auto; padding: 58px 0; } .hero h1 { font-size: clamp(50px, 15vw, 82px); letter-spacing: -.035em; } .lead { font-size: 19px; } .section { padding: 70px 0; } .section h2 { font-size: 44px; } }
      @media print { .topbar { position: static; } .navlinks { display: none; } .hero h1, .section h2 { letter-spacing: -.02em; } .section { break-inside: avoid; } }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="#top">Global Health Signals</a>
        <nav class="navlinks" aria-label="Report navigation">
          <a href="#question"><small>01</small> Question</a>
          <a href="#data"><small>02</small> Dataset</a>
          <a href="#model"><small>03</small> Model</a>
          <a href="#residuals"><small>04</small> Residuals</a>
          <a href="#sources"><small>05</small> Sources</a>
        </nav>
      </div>
    </header>
    <div class="shell">
      <main id="top">
        <section class="hero"><div><p class="eyebrow">WHO GHO Data / TabPFN / Health Intelligence</p><h1>From public health data to <em>predictive evidence.</em></h1><div class="hero-grid"><p class="lead">{summary.analytical_question}</p><div class="note-card"><p>This report converts heterogeneous WHO country-year indicators into a modeling layer, then asks whether a tabular foundation model can recover a meaningful life-expectancy signal. The value is not only the score: the residuals show where countries depart from the pattern expected by the available data.</p><div class="tags"><span class="tag">WHO GHO API</span><span class="tag">Life expectancy</span><span class="tag">TabPFN</span><span class="tag">Prior Labs</span><span class="tag">Interactive residuals</span></div></div></div></div></section>

        <section class="section" id="question"><div class="section-head"><span class="chapter">00 / Analytical architecture</span><div><h2>A country-year prediction problem, not a generic dashboard.</h2><p class="section-copy">The unit of analysis is a country in a year. The target is life expectancy at birth. The features are mortality, immunization, expenditure, disease and data-quality indicators from WHO. The purpose is to test signal strength, benchmark model performance and identify records that deserve policy-context follow-up.</p></div></div><div class="flow"><div class="flow-step"><small>01</small><strong>Acquire</strong><span>Pull public indicators from the WHO GHO OData API.</span></div><div class="flow-step"><small>02</small><strong>Structure</strong><span>Convert indicators into a country-year analytical table.</span></div><div class="flow-step"><small>03</small><strong>Audit</strong><span>Measure coverage, missingness and modeling readiness.</span></div><div class="flow-step"><small>04</small><strong>Model</strong><span>Compare Ridge, Random Forest and TabPFN on a temporal split.</span></div><div class="flow-step"><small>05</small><strong>Interpret</strong><span>Use residuals to find countries above or below expected outcomes.</span></div></div><div class="decision-grid"><article class="decision"><strong>Why bars?</strong><span>Coverage and regional completeness are ranked comparisons. Horizontal bars keep long indicator names readable and preserve the ranking logic.</span></article><article class="decision"><strong>Why line chart?</strong><span>Yearly residual error is temporal. A line chart shows the 2015–2021 increase more clearly than a table.</span></article><article class="decision"><strong>Why cards?</strong><span>Country residuals are case leads. Cards work better than a dense table because each country can later become a drill-down profile.</span></article><article class="decision"><strong>Why benchmark cards?</strong><span>The model comparison is executive-facing: MAE, RMSE and R² need to be readable before any technical detail.</span></article></div></section>

        <section class="section" id="data"><div class="section-head"><span class="chapter">01 / Data foundation</span><div><h2>The dataset is global, but not equally complete.</h2><p class="section-copy">The first analytical decision is to keep data quality visible. Coverage is not just a preprocessing concern: it changes how much confidence we should place in cross-country comparisons and helps explain why some regions or countries are harder to model.</p></div></div><MetricCards summary={summary} client:load /><div class="grid2"><BarInsightChart client:load title="Variable coverage profile" description="Click a row to inspect coverage. Higher coverage means the indicator appears in more country-year rows and is more stable for cross-country modeling." data={coverage} labelKey="variable_name" valueKey="non_null_share" mode="percent" detailTitle="Selected variable" detailBuilder={(row) => `Coverage in the country-year table: ${Math.round(Number(row.non_null_share) * 100)}%. Missing share: ${Math.round(Number(row.missing_share) * 100)}%.`} /><BarInsightChart client:load title="Completeness by WHO region" description="Click a region to inspect its average data completeness. This is a governance signal, not a performance ranking." data={completeness} labelKey="region" valueKey="mean_completeness" mode="percent" detailTitle="Selected region" detailBuilder={(row) => `Average data completeness across ${Number(row.countries).toLocaleString('en-US')} countries and ${Number(row.rows).toLocaleString('en-US')} country-year rows.`} /></div></section>

        <section class="section" id="model"><div class="section-head"><span class="chapter">02 / Model benchmark</span><div><h2>TabPFN is the only model below one year of average error.</h2><p class="section-copy">The split is temporal: records before 2015 train the models, and records from 2015 onward test them. This prevents the report from only measuring fit on historical data and makes the result closer to a forward-looking evaluation.</p></div></div><div class="panel"><div class="story"><div><h3>Executive reading</h3><p><b>MAE</b> is the average absolute difference between predicted and observed life expectancy. A value of 0.94 means the TabPFN estimate missed the observed outcome by less than one year on average.</p><p><b>R²</b> measures explained variation. TabPFN reached 0.96 on the recent test set, compared with 0.88 for Random Forest and 0.76 for Ridge.</p><p>The comparison matters because it shows the gain is not simply a product of the dataset. The tabular foundation model extracts more usable structure from the same input table.</p></div><div><ModelComparison models={models} client:load /></div></div></div></section>

        <section class="section" id="residuals"><div class="section-head"><span class="chapter">03 / Residual intelligence</span><div><h2>The error layer is where the report becomes investigative.</h2><p class="section-copy">Residuals are calculated as observed minus predicted life expectancy. Positive residuals indicate performance above the model expectation; negative residuals indicate outcomes below what the available indicators suggested. These are not labels of success or failure. They are leads for deeper analysis.</p></div></div><ResidualFindings findings={summary.executive_findings} client:load /><div class="grid2" style="margin-top:14px"><BarInsightChart client:load title="Regional model difficulty" description="Click a region to compare mean absolute prediction error. Higher error suggests the model needs more local context." data={regionResiduals} labelKey="region" valueKey="mean_abs_error" detailTitle="Selected region" detailBuilder={(row) => `Mean absolute prediction error: ${Number(row.mean_abs_error).toFixed(2)} years. Rows: ${Number(row.rows).toLocaleString('en-US')}. Countries: ${Number(row.countries).toLocaleString('en-US')}.`} /><div class="panel"><div class="panel-pad"><h3>Temporal stress point</h3><p class="explain">Hover the points. Error rises in 2021, suggesting a stress period where mortality patterns shifted faster than the selected features could summarize.</p><LineStressChart data={yearResiduals} client:load /></div></div></div></section>

        <section class="section" id="brief"><div class="section-head"><span class="chapter">04 / Intelligence brief</span><div><h2>What the first version already supports.</h2><p class="section-copy">The first result supports a concise executive conclusion: WHO indicators contain predictive signal for life expectancy, TabPFN improves the benchmark, and the most valuable next layer is a country-level residual investigation.</p></div></div><div class="brief-grid"><article class="brief"><h3>Conclusion</h3><p>Public health indicators can estimate recent life expectancy with high accuracy when structured as a country-year tabular problem.</p></article><article class="brief"><h3>Risk</h3><p>Data completeness remains uneven. Any executive use of the model should keep the coverage layer visible beside predictions.</p></article><article class="brief"><h3>Next analysis</h3><p>Eswatini, Kuwait 2021 and high-error regional clusters should become case cards with local context and indicator trajectories.</p></article></div><div class="panel" style="margin-top:14px"><div class="panel-pad"><h3>Highest-error country profiles</h3><p class="explain">Click a card to inspect the case. A high error can reflect a true shock, missing variables, country-specific dynamics, or indicator lag.</p></div><CountryCaseGrid countries={countryResiduals} client:load /></div></section>

        <section class="section" id="sources"><div class="section-head"><span class="chapter">05 / Sources, tools and reproducibility</span><div><h2>What was used, and why it matters.</h2><p class="section-copy">The report separates public source data, modeling layer and presentation layer. That makes the result easier to audit: data extraction can be rerun, model outputs can be compared against baselines, and the report can be rebuilt from exported JSON assets.</p></div></div><div class="source-grid"><article class="source-card"><span class="source-kicker">Data source</span><h3>WHO Global Health Observatory</h3><p>The WHO GHO OData API was used to retrieve the indicator catalog, dimensions and indicator-level country-year records. The target variable is life expectancy at birth, queried through the WHO indicator endpoint.</p><a class="source-link" href="https://www.who.int/data/gho/info/gho-odata-api" target="_blank" rel="noreferrer">WHO GHO OData API ↗</a></article><article class="source-card"><span class="source-kicker">Model source</span><h3>Prior Labs / TabPFN-3</h3><p>The modeling layer uses the Prior Labs TabPFN API conceptually aligned with the TabPFN-3 release: a foundation model for tabular prediction. The project benchmarks it against Ridge and Random Forest to avoid presenting a single model in isolation.</p><a class="source-link" href="https://huggingface.co/Prior-Labs/tabpfn_3/tree/main" target="_blank" rel="noreferrer">TabPFN-3 model files ↗</a></article><article class="source-card"><span class="source-kicker">Technical reference</span><h3>TabPFN-3 model report</h3><p>The final report should cite the TabPFN-3 technical report because it explains the model family, the synthetic-prior training logic, the scaling claims and the benchmark context behind the model choice.</p><a class="source-link" href="https://arxiv.org/abs/2605.13986" target="_blank" rel="noreferrer">TabPFN-3 technical report ↗</a></article></div><div class="source-grid" style="margin-top:14px"><article class="source-card"><span class="source-kicker">Python stack</span><h3>Data and modeling environment</h3><ul><li>pandas ≥ 2.2, numpy ≥ 1.26, requests ≥ 2.32 and pyarrow ≥ 16 for extraction and tabular processing.</li><li>scikit-learn ≥ 1.5 for Ridge and Random Forest baselines.</li><li>matplotlib, Plotly and Altair are kept in the project for static and exploratory visualization assets.</li></ul></article><article class="source-card"><span class="source-kicker">Web stack</span><h3>Interactive report layer</h3><ul><li>Astro is used for the static report shell, routing and SEO-friendly build.</li><li>Svelte components are used for interactive charts, model cards, tooltips and country case selection.</li><li>D3 is available for custom chart architecture, scales and future graph/network views.</li></ul></article><article class="source-card"><span class="source-kicker">Analytical limitation</span><h3>What this version does not claim</h3><p>The report estimates life expectancy from selected public indicators. It does not establish causality, does not replace local epidemiological review and should not rank health systems without country-level context.</p></article></div></section>
      </main>
      <footer class="footer">Built from WHO Global Health Observatory data. Modeling layer: Prior Labs / TabPFN. Repository: who-global-health-signals.</footer>
    </div>
  </body>
</html>
