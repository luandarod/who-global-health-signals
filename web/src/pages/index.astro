<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Global Health Signals | WHO + TabPFN</title>
    <meta name="description" content="Executive analytical report using WHO Global Health Observatory data and TabPFN to model life expectancy, data quality and residual signals." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root{--bg:#050505;--ink:#f8f3e8;--soft:#dfd7ca;--muted:#a8a095;--dim:#716b63;--line:rgba(248,243,232,.14);--line2:rgba(248,243,232,.24);--panel:rgba(255,255,255,.045);--panel2:rgba(255,255,255,.075);--green:#d7ff6f;--blue:#9fc8ff;--red:#ff8a7a;--violet:#c8b6ff}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 84% 7%,rgba(215,255,111,.11),transparent 22%),radial-gradient(circle at 4% 32%,rgba(159,200,255,.09),transparent 27%),radial-gradient(circle at 76% 78%,rgba(200,182,255,.07),transparent 24%),var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;background:linear-gradient(rgba(248,243,232,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(248,243,232,.025) 1px,transparent 1px);background-size:78px 78px;pointer-events:none;z-index:-1}a{color:inherit;text-decoration:none}.shell{max-width:1480px;margin:0 auto;padding:28px}.nav{min-height:64px;display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid var(--line);position:sticky;top:0;background:linear-gradient(to bottom,rgba(5,5,5,.98),rgba(5,5,5,.78));backdrop-filter:blur(18px);z-index:20}.mono,.brand,.navlinks,.eyebrow,.tag,.metric-label,.chapter-label,.note,.bar-value,.case-rank{font-family:'IBM Plex Mono',monospace}.brand{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--green);white-space:nowrap}.navlinks{display:flex;gap:18px;font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700}.hero{min-height:calc(100vh - 92px);display:grid;align-items:end;padding:86px 0 58px}.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:800}.hero h1{font-size:clamp(58px,9.2vw,142px);line-height:.82;letter-spacing:-.085em;margin:22px 0 28px;max-width:1220px}.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1px rgba(248,243,232,.72)}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;border-top:1px solid var(--line);padding-top:22px}.lead{font-size:24px;line-height:1.26;letter-spacing:-.04em;color:#e6ded1;margin:0}.executive-note{border:1px solid var(--line);border-radius:28px;padding:22px;background:linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.018))}.executive-note p{margin:0;color:var(--soft);line-height:1.48;font-size:15.5px}.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tag{border:1px solid var(--line);border-radius:999px;padding:8px 10px;font-size:11px;text-transform:uppercase;color:var(--muted);background:rgba(255,255,255,.03)}.section{padding:92px 0;border-top:1px solid var(--line)}.section-head{display:grid;grid-template-columns:260px 1fr;gap:36px;margin-bottom:30px}.chapter-label{display:block;color:var(--green);font-size:11px;text-transform:uppercase;letter-spacing:.12em;line-height:1.5;padding-top:8px}.chapter-label:after{content:"";display:block;width:100%;height:1px;background:var(--line);margin-top:18px}.section h2{font-size:clamp(40px,5.4vw,84px);line-height:.94;letter-spacing:-.07em;margin:0;max-width:960px}.section-copy{font-size:19px;line-height:1.48;color:var(--muted);margin:18px 0 0;max-width:850px}.story-card{border:1px solid var(--line);border-radius:30px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.018));overflow:hidden}.story-grid{display:grid;grid-template-columns:1fr 1fr}.story-text{padding:28px;border-right:1px solid var(--line)}.story-text:last-child{border-right:0}.story-text h3{font-size:30px;line-height:1.02;letter-spacing:-.055em;margin:0 0 14px}.story-text p{margin:0 0 14px;color:var(--soft);line-height:1.5;font-size:16px}.story-text p:last-child{margin-bottom:0}.method-flow{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:14px}.flow-step{position:relative;border:1px solid var(--line);border-radius:22px;padding:18px;background:rgba(0,0,0,.2);min-height:126px}.flow-step:not(:last-child):after{content:"→";position:absolute;right:-13px;top:44%;color:var(--green);font-family:'IBM Plex Mono';z-index:2}.flow-step small{display:block;color:var(--green);font-family:'IBM Plex Mono';font-size:10px;letter-spacing:.12em;text-transform:uppercase}.flow-step strong{display:block;font-size:20px;letter-spacing:-.04em;margin:10px 0}.flow-step span{color:var(--muted);font-size:13px;line-height:1.35}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric{border:1px solid var(--line);border-radius:24px;padding:22px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02))}.metric strong{display:block;font-size:clamp(34px,4vw,62px);letter-spacing:-.075em;line-height:.9}.metric-label{display:block;margin-top:12px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.viz-card{border:1px solid var(--line);border-radius:28px;padding:22px;background:linear-gradient(135deg,rgba(255,255,255,.052),rgba(255,255,255,.016));min-height:390px}.viz-card h3{font-size:25px;line-height:1.05;letter-spacing:-.055em;margin:0 0 8px}.viz-card .explain{color:var(--muted);font-size:14px;line-height:1.42;margin:0 0 20px}.bar-list{display:grid;gap:12px}.bar-row{display:grid;gap:7px}.bar-meta{display:flex;justify-content:space-between;gap:14px;align-items:flex-end}.bar-label{color:var(--soft);font-size:13px;line-height:1.25;max-width:78%;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.bar-value{color:var(--ink);font-size:12px;white-space:nowrap}.bar-track{height:12px;background:rgba(255,255,255,.085);border-radius:999px;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(255,255,255,.03)}.bar-fill{height:100%;background:linear-gradient(90deg,var(--green),rgba(215,255,111,.42));border-radius:999px}.model-stack{display:grid;gap:12px}.model-row{display:grid;grid-template-columns:190px 1fr 130px;gap:16px;align-items:center;border:1px solid var(--line);border-radius:24px;padding:18px;background:rgba(255,255,255,.03)}.model-row:first-child{background:linear-gradient(135deg,rgba(215,255,111,.14),rgba(255,255,255,.026));border-color:rgba(215,255,111,.40)}.model-row strong{font-size:21px;letter-spacing:-.04em}.model-row small{display:block;color:var(--muted);font-size:11px;margin-top:5px}.model-score{text-align:right}.model-score strong{display:block;color:var(--green);font-size:34px;line-height:.9}.model-score small{font-family:'IBM Plex Mono'}.model-note{font-size:13px;line-height:1.42;color:var(--muted);margin-top:10px}.residual-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.finding{border:1px solid var(--line);border-radius:24px;padding:22px;background:rgba(0,0,0,.20)}.finding strong{display:block;font-size:36px;letter-spacing:-.07em;color:var(--green);line-height:.95}.finding p{margin:12px 0 0;color:var(--muted);line-height:1.4}.finding b{color:var(--ink)}.line-chart{width:100%;height:310px}.brief-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.brief{border:1px solid var(--line);border-radius:24px;padding:22px;background:rgba(255,255,255,.035)}.brief h3{font-size:24px;line-height:1.05;letter-spacing:-.05em;margin:0 0 12px}.brief p{color:var(--muted);line-height:1.43;margin:0}.case-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:0 22px 22px}.case-card{border:1px solid var(--line);border-radius:20px;padding:15px;background:rgba(0,0,0,.22)}.case-rank{font-size:10px;color:var(--green);letter-spacing:.12em}.case-card strong{display:block;font-size:26px;line-height:.9;margin:12px 0 4px}.case-card span{display:block;color:var(--muted);font-size:12px;line-height:1.3}.case-metric{margin-top:12px;display:flex;justify-content:space-between;gap:8px;border-top:1px solid var(--line);padding-top:10px}.case-metric b{font-size:13px}.notice{border:1px solid var(--red);border-radius:20px;padding:18px;color:#ffd6d6;background:rgba(255,119,119,.08);margin:24px 0}.footer{padding:70px 0 30px;color:var(--muted);border-top:1px solid var(--line)}.reveal{opacity:1;transform:none;transition:opacity .7s ease,transform .7s ease}.js .reveal{opacity:0;transform:translateY(22px)}.js .reveal.in{opacity:1;transform:none}@media(max-width:1100px){.section-head{grid-template-columns:1fr}.chapter-label:after{width:160px}.hero-grid,.story-grid,.metrics,.chart-grid,.residual-grid,.brief-grid,.method-flow{grid-template-columns:1fr}.story-text{border-right:0;border-bottom:1px solid var(--line)}.story-text:last-child{border-bottom:0}.flow-step:after{display:none}.case-grid{grid-template-columns:1fr 1fr}.model-row{grid-template-columns:1fr}.model-score{text-align:left}}@media(max-width:720px){.shell{padding:18px}.nav{height:auto;padding:14px 0;align-items:flex-start;gap:12px;flex-direction:column}.navlinks{overflow-x:auto;gap:10px;width:100%;padding-bottom:4px}.hero{min-height:auto;padding:58px 0}.hero h1{font-size:clamp(50px,15vw,82px)}.lead{font-size:19px}.section{padding:70px 0}.section h2{font-size:44px}.case-grid{grid-template-columns:1fr}.viz-card{min-height:auto}.bar-label{max-width:70%}}
    </style>
  </head>
  <body>
    <script>document.documentElement.classList.add('js');</script>
    <div class="shell">
      <nav class="nav"><a class="brand" href="#top">Global Health Signals</a><div class="navlinks"><a href="#question">Question</a><a href="#data">Data</a><a href="#model">Model</a><a href="#residuals">Residuals</a><a href="#brief">Brief</a></div></nav>
      <main id="top">
        <section class="hero"><div><p class="eyebrow reveal">WHO GHO Data / TabPFN / Health Intelligence</p><h1 class="reveal">From public health data to <em>predictive evidence.</em></h1><div class="hero-grid reveal"><p class="lead" id="heroLead">Can public health indicators from WHO explain and predict differences in life expectancy across countries?</p><div class="executive-note"><p>This report converts heterogeneous WHO country-year indicators into a modeling layer, then asks whether a tabular foundation model can recover a meaningful life-expectancy signal. The value is not only the score: the residuals show where countries depart from the pattern expected by the available data.</p><div class="tags"><span class="tag">WHO GHO API</span><span class="tag">Life expectancy</span><span class="tag">TabPFN</span><span class="tag">Prior Labs</span><span class="tag">Residual analysis</span></div></div></div><div id="loadNotice"></div></div></section>

        <section class="section" id="question"><div class="section-head reveal"><span class="chapter-label">00 / Analytical architecture</span><div><h2>A country-year prediction problem, not a generic dashboard.</h2><p class="section-copy">The unit of analysis is a country in a year. The target is life expectancy at birth. The features are mortality, immunization, expenditure, disease and data-quality indicators from WHO. The purpose is to test signal strength, benchmark model performance and identify records that deserve policy-context follow-up.</p></div></div><div class="method-flow reveal"><div class="flow-step"><small>01</small><strong>Acquire</strong><span>Pull public indicators from the WHO GHO OData API.</span></div><div class="flow-step"><small>02</small><strong>Structure</strong><span>Convert indicators into a country-year analytical table.</span></div><div class="flow-step"><small>03</small><strong>Audit</strong><span>Measure coverage, missingness and modeling readiness.</span></div><div class="flow-step"><small>04</small><strong>Model</strong><span>Compare Ridge, Random Forest and TabPFN on a temporal split.</span></div><div class="flow-step"><small>05</small><strong>Interpret</strong><span>Use residuals to find countries above or below expected outcomes.</span></div></div></section>

        <section class="section" id="data"><div class="section-head reveal"><span class="chapter-label">01 / Data foundation</span><div><h2>The dataset is global, but not equally complete.</h2><p class="section-copy">The first analytical decision is to keep data quality visible. Coverage is not just a preprocessing concern: it changes how much confidence we should place in cross-country comparisons and helps explain why some regions or countries are harder to model.</p></div></div><div class="metrics reveal" id="datasetMetrics"></div><div class="chart-grid reveal"><div class="viz-card"><h3>Variable coverage profile</h3><p class="explain">Higher coverage means the indicator appears in more country-year rows. These variables form the most stable part of the predictive foundation.</p><div class="bar-list" id="coverageBars"></div></div><div class="viz-card"><h3>Completeness by WHO region</h3><p class="explain">Regional completeness shows where the analytical table is more or less dense. Similar values can still hide country-level gaps, so this is a governance signal rather than a final ranking.</p><div class="bar-list" id="regionCompleteness"></div></div></div></section>

        <section class="section" id="model"><div class="section-head reveal"><span class="chapter-label">02 / Model benchmark</span><div><h2>TabPFN is the only model below one year of average error.</h2><p class="section-copy">The split is temporal: records before 2015 train the models, and records from 2015 onward test them. This prevents the report from only measuring fit on historical data and makes the result closer to a forward-looking evaluation.</p></div></div><div class="story-card reveal"><div class="story-grid"><div class="story-text"><h3>Executive reading</h3><p><b>MAE</b> is the average absolute difference between predicted and observed life expectancy. A value of 0.94 means the TabPFN estimate missed the observed outcome by less than one year on average.</p><p><b>R²</b> measures explained variation. TabPFN reached 0.96 on the recent test set, compared with 0.88 for Random Forest and 0.76 for Ridge.</p><p>The comparison matters because it shows the gain is not simply a product of the dataset. The tabular foundation model extracts more usable structure from the same input table.</p></div><div class="story-text"><div class="model-stack" id="modelComparison"></div></div></div></div></section>

        <section class="section" id="residuals"><div class="section-head reveal"><span class="chapter-label">03 / Residual intelligence</span><div><h2>The error layer is where the report becomes investigative.</h2><p class="section-copy">Residuals are calculated as observed minus predicted life expectancy. Positive residuals indicate performance above the model expectation; negative residuals indicate outcomes below what the available indicators suggested. These are not labels of success or failure. They are leads for deeper analysis.</p></div></div><div class="residual-grid reveal" id="findingCards"></div><div class="chart-grid reveal"><div class="viz-card"><h3>Regional model difficulty</h3><p class="explain">Mean absolute error by WHO region. Africa has the highest average error, which suggests either more heterogeneous country profiles, sharper shocks, weaker feature coverage, or missing contextual variables.</p><div class="bar-list" id="regionResiduals"></div></div><div class="viz-card"><h3>Temporal stress point</h3><p class="explain">Average error rises in 2021. That pattern is consistent with a period where mortality and system disruption may have shifted faster than the selected WHO indicators could summarize.</p><svg class="line-chart" id="yearResiduals" viewBox="0 0 600 310"></svg></div></div></section>

        <section class="section" id="brief"><div class="section-head reveal"><span class="chapter-label">04 / Intelligence brief</span><div><h2>What the first version already supports.</h2><p class="section-copy">The first result is strong enough to support a concise executive conclusion: WHO indicators contain predictive signal for life expectancy, TabPFN improves the benchmark, and the most valuable next layer is a country-level residual investigation.</p></div></div><div class="brief-grid reveal"><article class="brief"><h3>Conclusion</h3><p>Public health indicators can estimate recent life expectancy with high accuracy when structured as a country-year tabular problem.</p></article><article class="brief"><h3>Risk</h3><p>Data completeness remains uneven. Any executive use of the model should keep the coverage layer visible beside predictions.</p></article><article class="brief"><h3>Next analysis</h3><p>Eswatini, Kuwait 2021 and high-error regional clusters should become case cards with local context and indicator trajectories.</p></article></div><div class="story-card reveal" style="margin-top:14px"><div class="story-text" style="border-right:0;border-bottom:1px solid var(--line)"><h3>Highest-error country profiles</h3><p>These cases are where the model needs more context. A high error can reflect a true shock, missing variables, country-specific dynamics, or indicator lag. The next report version should convert these into drill-down case studies.</p></div><div class="case-grid" id="countryCases"></div></div></section>
      </main>
      <footer class="footer">Built from WHO Global Health Observatory data. Modeling layer: Prior Labs / TabPFN. Repository: who-global-health-signals.</footer>
    </div>
    <script type="module">
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => Number(n).toLocaleString('en-US', { maximumFractionDigits: 2 });
      const labelName = (s) => String(s ?? '').replaceAll('_', ' ').replace(/\b\w/g, c => c.toUpperCase());
      const load = async (name) => { const response = await fetch(`/data/${name}.json`, { cache: 'no-store' }); if (!response.ok) throw new Error(`Could not load /data/${name}.json (${response.status})`); return response.json(); };
      function bars(el, data, label, value, max = null) { const values = data.map((d) => Number(d[value]) || 0); const m = max ?? Math.max(...values, 0.01); el.innerHTML = data.map((d) => `<div class="bar-row"><div class="bar-meta"><span class="bar-label" title="${labelName(d[label])}">${labelName(d[label])}</span><span class="bar-value">${fmt(Number(d[value]) || 0)}</span></div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(2, ((Number(d[value]) || 0) / m) * 100)}%"></div></div></div>`).join(''); }
      function drawYearLine(svg, data) { const w = 600, h = 310, margin = { top: 24, right: 24, bottom: 38, left: 48 }; const years = data.map((d) => Number(d.year)); const vals = data.map((d) => Number(d.mean_abs_error)); const minX = Math.min(...years), maxX = Math.max(...years), maxY = Math.max(...vals) * 1.15; const sx = (x) => margin.left + ((x - minX) / Math.max(1, maxX - minX)) * (w - margin.left - margin.right); const sy = (y) => h - margin.bottom - (y / Math.max(0.01, maxY)) * (h - margin.top - margin.bottom); const points = data.map((d) => `${sx(Number(d.year))},${sy(Number(d.mean_abs_error))}`).join(' '); const xTicks = [...new Set(years)].filter((_, i) => i % 2 === 0); const yTicks = [0, maxY / 2, maxY]; svg.innerHTML = `<rect x="0" y="0" width="600" height="310" fill="rgba(255,255,255,.012)" rx="18"/><line x1="${margin.left}" y1="${h-margin.bottom}" x2="${w-margin.right}" y2="${h-margin.bottom}" stroke="rgba(248,243,232,.18)"/><line x1="${margin.left}" y1="${margin.top}" x2="${margin.left}" y2="${h-margin.bottom}" stroke="rgba(248,243,232,.18)"/>${yTicks.map(t=>`<line x1="${margin.left}" y1="${sy(t)}" x2="${w-margin.right}" y2="${sy(t)}" stroke="rgba(248,243,232,.07)"/><text x="${margin.left-8}" y="${sy(t)+4}" fill="#a8a095" font-size="10" text-anchor="end">${fmt(t)}</text>`).join('')}${xTicks.map(t=>`<text x="${sx(t)}" y="${h-13}" fill="#a8a095" font-size="10" text-anchor="middle">${t}</text>`).join('')}<polyline points="${points}" fill="none" stroke="#d7ff6f" stroke-width="2.4"/>${data.map(d=>`<circle cx="${sx(Number(d.year))}" cy="${sy(Number(d.mean_abs_error))}" r="4.5" fill="#f8f3e8"/><circle cx="${sx(Number(d.year))}" cy="${sy(Number(d.mean_abs_error))}" r="10" fill="rgba(215,255,111,.08)"/>`).join('')}`; }
      function showError(error) { console.error(error); $('loadNotice').innerHTML = `<div class="notice"><strong>Data assets did not load.</strong><br>Run <code>python scripts/11_export_report_assets.py</code> and <code>python scripts/12_prepare_web_assets.py</code>, then restart <code>npm.cmd run dev</code>. Details: ${error.message}</div>`; document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in')); }
      async function main() { try { const [summary, models, regionRes, yearRes, countryRes, completeness, coverage] = await Promise.all(['report_summary','model_comparison','region_residuals','year_residuals','country_residuals_top','data_completeness_by_region','variable_coverage'].map(load)); $('heroLead').textContent = summary.analytical_question; $('datasetMetrics').innerHTML = `<div class="metric"><strong>${fmt(summary.dataset.full_rows)}</strong><span class="metric-label">country-year rows</span></div><div class="metric"><strong>${fmt(summary.dataset.countries)}</strong><span class="metric-label">countries/entities</span></div><div class="metric"><strong>${summary.dataset.min_year}–${summary.dataset.max_year}</strong><span class="metric-label">historical range</span></div><div class="metric"><strong>${fmt(summary.best_model.test_mae)}</strong><span class="metric-label">TabPFN MAE years</span></div>`; bars($('coverageBars'), coverage.slice(0,10), 'variable_name', 'non_null_share', 1); bars($('regionCompleteness'), completeness, 'region', 'mean_completeness'); const maxMae = Math.max(...models.map(m => Number(m.test_mae))); $('modelComparison').innerHTML = models.map((m) => `<div class="model-row"><div><strong>${labelName(m.model)}</strong><small>${fmt(m.test_rows)} recent test rows</small></div><div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(5, (1 - Number(m.test_mae) / maxMae) * 82 + 18)}%"></div></div><p class="model-note">RMSE ${fmt(m.test_rmse)} · R² ${fmt(m.test_r2)}</p></div><div class="model-score"><strong>${fmt(m.test_mae)}</strong><small>MAE years</small></div></div>`).join(''); const findingPick = ['overall_error','best_region','worst_region','worst_year','positive_outlier','negative_outlier']; $('findingCards').innerHTML = summary.executive_findings.filter((d) => findingPick.includes(d.finding_id)).map((d) => `<article class="finding"><strong>${typeof d.value === 'number' ? fmt(d.value) : d.value}</strong><p><b>${d.metric}</b><br>${d.finding}</p></article>`).join(''); bars($('regionResiduals'), regionRes.sort((a,b) => Number(a.mean_abs_error) - Number(b.mean_abs_error)), 'region', 'mean_abs_error'); drawYearLine($('yearResiduals'), yearRes); $('countryCases').innerHTML = countryRes.slice(0,10).map((d, i) => `<article class="case-card"><span class="case-rank">#${String(i+1).padStart(2,'0')}</span><strong>${d.country_code}</strong><span>${d.region ?? 'Unknown region'}</span><div class="case-metric"><span>mean error</span><b>${fmt(d.mean_abs_error)}</b></div><div class="case-metric"><span>residual</span><b>${fmt(d.mean_residual)}</b></div></article>`).join(''); const observer = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('in'); }), { threshold: .12 }); document.querySelectorAll('.reveal').forEach((el) => observer.observe(el)); setTimeout(() => document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in')), 400); } catch (error) { showError(error); } }
      main();
    </script>
  </body>
</html>
